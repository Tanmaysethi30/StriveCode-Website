---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mentorship | StriveCode Technology"
  description="StriveCode Technology - Enterprise Tech, Training & Career Acceleration"
  currentRoute="/mentorship"
  hasGridMatrix={true}
  isHome={false}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/mentorship-logo.css" />
    <link rel="stylesheet" href="/mentorship-dots.css" />
    <link rel="stylesheet" href="/mentorship-nav.css" />
    <script is:inline>
      if (typeof window !== 'undefined' && (window.scrollY || 0) < 20) {
        document.documentElement.classList.add('sc-mnav-hero-initial');
      }
    </script>
    <style is:inline>
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        display: inline-block;
        vertical-align: middle;
        line-height: 1;
      }

      /* Subtle custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #eeeeee;
      }
      ::-webkit-scrollbar-thumb {
        background: #c6c5d2;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #767682;
      }

      /* 3D tilt perspective wrapper */
      .perspective-container {
        perspective: 1200px;
      }
      .tilt-card {
        transform-style: preserve-3d;
        transition: transform 0.15s ease-out, box-shadow 0.25s ease;
        will-change: transform;
      }

      /* Aurora Breathing Animation for Hero Background */
      @keyframes auroraBreathing {
        0%, 100% {
          transform: scale(1) translate(0%, 0%);
          opacity: 0.65;
        }
        50% {
          transform: scale(1.1) translate(-2%, 2%);
          opacity: 0.85;
        }
      }
      .hero-aurora-glow {
        animation: auroraBreathing 8s ease-in-out infinite;
      }

      /* Kinetic Motto: Campus High-Contrast Pure White Crisp Glow */
      @keyframes campusFill {
        0% {
          color: rgba(255, 255, 255, 0.4);
          text-shadow: none;
        }
        60% {
          color: rgba(255, 255, 255, 0.95);
        }
        100% {
          color: #ffffff;
          text-shadow: 0 2px 20px rgba(255, 255, 255, 0.6), 0 0 35px rgba(218, 18, 18, 0.3);
        }
      }
      .animate-campus-glow {
        animation: campusFill 1.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        color: #ffffff;
      }

      /* Kinetic Motto: Bridge Line Draw */
      @keyframes drawBridgeLine {
        0% {
          stroke-dashoffset: 320;
          opacity: 0.2;
        }
        30% {
          opacity: 1;
        }
        100% {
          stroke-dashoffset: 0;
          opacity: 1;
        }
      }
      .animate-bridge-path {
        stroke-dasharray: 320;
        stroke-dashoffset: 320;
        animation: drawBridgeLine 1.3s cubic-bezier(0.25, 1, 0.5, 1) 0.4s forwards;
      }

      /* Kinetic Motto: Corporate 3D Flip & Metallic Sweep */
      @keyframes corporateFlip {
        0% {
          opacity: 0;
          transform: perspective(700px) rotateX(90deg) translateY(18px);
        }
        70% {
          opacity: 1;
          transform: perspective(700px) rotateX(-10deg) translateY(-2px);
        }
        100% {
          opacity: 1;
          transform: perspective(700px) rotateX(0deg) translateY(0);
        }
      }
      .animate-corporate-flip {
        opacity: 0;
        transform-origin: bottom center;
        animation: corporateFlip 1s cubic-bezier(0.34, 1.56, 0.64, 1) 1.1s forwards;
      }

      @keyframes metallicSweep {
        0% {
          background-position: -200% center;
        }
        100% {
          background-position: 200% center;
        }
      }
      .metallic-corporate-text {
        background: linear-gradient(110deg, #da1212 0%, #ffffff 35%, #ffb4a9 60%, #ffffff 100%);
        background-size: 260% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: metallicSweep 3.6s ease-in-out 1.8s infinite alternate;
      }

      /* Apple-inspired Apply Now CTA micro-interaction */
      .apply-now-btn {
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
      }
      .apply-now-btn:hover {
        transform: translateY(-2px) scale(1.04);
        box-shadow: 0 10px 24px -6px rgba(218, 18, 18, 0.45);
      }
      .apply-now-btn:hover .btn-arrow {
        transform: translateX(4px);
      }
    </style>
  </Fragment>

  <!-- Interactive Canvas: Cursor-Reactive Mesh & Ambient Grid -->
  <canvas class="fixed inset-0 pointer-events-none z-0 w-full h-full opacity-70" height="4676" id="meshCanvas" width="1280"></canvas>

  <div class="relative z-10 flex-grow">
<!-- ========================================================================= -->
<!-- 2. HUMANIZED HERO SECTION (Immersive Navy Envelope, High Contrast, Smooth Transition) -->
<!-- ========================================================================= -->
<section class="relative pt-20 pb-28 px-6 lg:px-12 text-center overflow-hidden bg-[#041562]" id="heroSection">
<canvas class="sc-flow-dots" id="sc-flow-dots-canvas" aria-hidden="true"></canvas>
<!-- Ambient Aurora / Mesh Gradient Wave Background Enveloping Entire Hero Section -->
<div class="hero-aurora-glow absolute inset-0 pointer-events-none z-0 overflow-hidden">
<div class="absolute -top-32 -left-24 w-[650px] h-[650px] rounded-full bg-[#081d7a] opacity-50 blur-[130px]"></div>
<div class="absolute top-1/4 -right-32 w-[700px] h-[700px] rounded-full bg-[#0b248a] opacity-45 blur-[140px]"></div>
<div class="absolute bottom-10 left-1/3 w-[600px] h-[600px] rounded-full bg-[#da1212] opacity-[0.14] blur-[160px]"></div>
<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[550px] rounded-full bg-[#041562] opacity-85 blur-[120px]"></div>
</div>
<div class="relative z-10 max-w-7xl mx-auto">
<!-- StriveCode Mentorship Hero Logo -->
<div class="sc-ml-container" id="scMentorshipLogo" aria-label="StriveCode Mentorship Logo">
  <div class="sc-ml-wrap">
    <!-- Entrance Ripple Effect -->
    <div class="sc-ml-ripple" aria-hidden="true"></div>
    
    <!-- Ambient Breathing Halo / Glow -->
    <div class="sc-ml-halo" aria-hidden="true"></div>
    
    <!-- Orbit Accent Ring with Glowing Dots -->
    <div class="sc-ml-orbit-ring" aria-hidden="true">
      <span class="sc-ml-dot sc-ml-dot-red"></span>
      <span class="sc-ml-dot sc-ml-dot-gold"></span>
    </div>
    
    <!-- Logo Disc Badge -->
    <div class="sc-ml-logo-box">
      <img src="/mentorship-logo.png" 
           alt="StriveCode Mentorship Logo" 
           width="128" 
           height="128" 
           loading="eager" 
           class="sc-ml-img">
      <!-- Light Sweep Shimmer Effect -->
      <span class="sc-ml-shine" aria-hidden="true"></span>
    </div>
  </div>
</div>
<!-- Pill Badge: STRICTLY NO DOTS -->
<div class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-md shadow-sm mb-8">
<span class="text-label-sm font-label-sm tracking-wider text-[#ffdad5] font-extrabold uppercase">
          ACADEMIC &amp; INDUSTRY MENTORSHIP
        </span>
</div>
<!-- Animated Hero Motto: PRIMARY OVERSIZED DISPLAY HEADLINE (Campus to Corporate) -->
<h1 class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 lg:gap-8 mb-8 py-2 font-display tracking-tight select-none"><span class="animate-campus-glow text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold uppercase drop-shadow-xl text-white">Campus</span><span class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-[#da1212] tracking-wider my-auto animate-corporate-flip">to</span><span class="animate-corporate-flip inline-block"><span class="metallic-corporate-text text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold uppercase drop-shadow-xl">Corporate</span></span></h1>
<!-- Subtitle Headline directly beneath (Crisp Pure White) -->
<h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-white max-w-4xl mx-auto font-bold tracking-tight drop-shadow-sm">Guided by Academic Excellence &amp; Industry Leadership</h2>
<!-- Subtitle description (#FFFFFF at 85% opacity for crisp legibility) -->
<p class="font-body-lg text-base sm:text-lg text-white/85 max-w-3xl mx-auto mt-4 leading-relaxed">Direct mentorship with Dr. Swati Sharma — trusted by 1,500+ students and professionals for holistic career and academic growth. Bridging corporate strategy, higher education, and holistic student development to shape enterprise-ready professionals.</p>
<!-- Floating Frosted Glassmorphic Metrics Ribbon (Envelope Seamlessly in Deep Navy) -->
<div class="mt-14 max-w-5xl mx-auto bg-white/[0.08] backdrop-blur-md rounded-xl p-6 lg:p-8 shadow-2xl border border-white/20">
<div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-white/15">
<div class="pt-2 md:pt-0 px-3">
<div class="text-headline-md font-headline-md font-extrabold text-white">15+ Years</div>
<div class="text-label-md font-label-md text-[#eeeeee]/90 mt-1">Academic &amp; Corporate Mentorship</div>
</div>
<div class="pt-4 md:pt-0 px-3">
<div class="text-headline-md font-headline-md font-extrabold text-white">Ph.D. Guided</div>
<div class="text-label-md font-label-md text-[#eeeeee]/90 mt-1">Research &amp; Human Capital Strategy</div>
</div>
<div class="pt-4 md:pt-0 px-3">
<div class="text-headline-md font-headline-md font-extrabold text-white">100%</div>
<div class="text-label-md font-label-md text-[#eeeeee]/90 mt-1">Corporate Placement Alignment</div>
</div>
<div class="pt-4 md:pt-0 px-3">
<div class="text-headline-md font-headline-md font-extrabold text-white">7 Core Domains</div>
<div class="text-label-md font-label-md text-[#eeeeee]/90 mt-1">Multidisciplinary Student Excellence</div>
</div>
</div>
</div>
</div>
</section>
<!-- Seamless, Soothing Continuous Gradient Scroll Ramp (#041562 to #eeeeee) -->
<div class="w-full h-28 lg:h-36 bg-gradient-to-b from-[#041562] via-[#041562]/60 to-transparent pointer-events-none" id="heroScrollTransition"></div>
<!-- ========================================================================= -->
<!-- 3. FLAGSHIP MENTOR SPOTLIGHT — 3D BENTO SHOWCASE (Dr. Swati Sharma) -->
<!-- ========================================================================= -->
<section class="py-16 px-6 lg:px-12 max-w-7xl mx-auto" id="mentor-spotlight">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
<!-- Left Column (Sticky Portrait & Identity Card) -->
<div class="lg:col-span-5 lg:sticky lg:top-28">
<div class="perspective-container">
<div class="tilt-card rounded-2xl bg-gradient-to-b from-[#041562] to-[#081d7a] p-6 lg:p-8 text-on-primary shadow-xl border border-white/20 relative overflow-hidden group" id="heroCardTilt" style="transform: rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1);"><div class="absolute top-4 left-4 w-6 h-6 border-t-2 border-l-2 border-[#da1212]/60 transition-all duration-300 group-hover:scale-110 group-hover:border-[#da1212]"></div><div class="absolute top-4 right-4 w-6 h-6 border-t-2 border-r-2 border-[#da1212]/60 transition-all duration-300 group-hover:scale-110 group-hover:border-[#da1212]"></div><div class="absolute bottom-4 left-4 w-6 h-6 border-b-2 border-l-2 border-[#da1212]/60 transition-all duration-300 group-hover:scale-110 group-hover:border-[#da1212]"></div><div class="absolute bottom-4 right-4 w-6 h-6 border-b-2 border-r-2 border-[#da1212]/60 transition-all duration-300 group-hover:scale-110 group-hover:border-[#da1212]"></div><div class="rounded-xl overflow-hidden relative shadow-md border border-white/20"><img alt="Faculty Profile Portrait of Dr. Swati Sharma" class="w-full h-[430px] object-cover object-top filter contrast-[1.02] transition-transform duration-500 group-hover:scale-[1.02]" src="/assets/downloaded/mentorship-dr-swati-sharma.jpg"><div class="absolute bottom-3 inset-x-3 bg-[#041562]/95 backdrop-blur-md p-4 rounded-lg border border-white/20 shadow-lg"><div class="text-[#da1212] font-label-sm font-bold tracking-widest uppercase">FACULTY PROFILE</div><h3 class="text-headline-sm font-headline-sm font-bold text-white mt-0.5">Dr. Swati Sharma</h3><div class="mt-2 inline-block px-3 py-1 rounded-full bg-white/10 border border-white/20 text-white text-label-sm font-semibold">Ph.D. | 15+ Years Experience</div></div></div><p class="font-body-md text-white/85 mt-4 leading-relaxed border-t border-white/15 pt-3">Fostering rigorous academic inquiry, corporate acumen, and transformative career trajectories through dedicated 1-on-1 pedagogical mentorship.</p></div>
</div>
</div>
<!-- Right Column (3 Interactive Bento Cards) -->
<div class="lg:col-span-7 flex flex-col space-y-6">
<!-- Card 01 — Professional Experience -->
<div class="bento-interactive-card bg-surface-container-lowest rounded-xl p-8 border border-primary-container/10 shadow-sm relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-l-4 hover:border-l-secondary group">
<span class="text-surface-container font-extrabold text-7xl absolute right-6 top-4 select-none pointer-events-none group-hover:text-surface-container-high transition-colors">01</span>
<div class="font-label-sm text-[#da1212] font-bold tracking-wider uppercase mb-3">01 | PROFESSIONAL EXPERIENCE</div>
<h4 class="text-headline-sm font-headline-sm font-bold text-primary-container mb-4">Strategic Mentorship &amp; Research Tenure</h4>
<p class="font-body-lg text-body-lg text-on-surface leading-relaxed">
<strong class="font-bold text-primary-container">15+ Years</strong> of experience across <strong class="font-bold text-primary-container">Corporate</strong>, <strong class="font-bold text-primary-container">Higher Education</strong>, <strong class="font-bold text-primary-container">Teaching</strong>, <strong class="font-bold text-primary-container">Training &amp; Research</strong>, with expertise in <strong class="font-bold text-primary-container">student mentoring</strong>, <strong class="font-bold text-primary-container">academic coordination</strong>, <strong class="font-bold text-primary-container">industry engagement</strong>, <strong class="font-bold text-primary-container">Training &amp; Placement</strong> and <strong class="font-bold text-primary-container">skill development</strong>.
            </p>
<div class="mt-6 pt-4 border-t border-surface-container flex flex-wrap gap-2">
<span class="text-label-sm font-semibold px-3 py-1 bg-surface-container rounded-lg text-primary-container">Faculty Mentorship</span>
<span class="text-label-sm font-semibold px-3 py-1 bg-surface-container rounded-lg text-primary-container">Corporate Governance</span>
<span class="text-label-sm font-semibold px-3 py-1 bg-surface-container rounded-lg text-primary-container">Curriculum Stewardship</span>
</div>
</div>
<!-- Card 02 — Academic Qualifications -->
<div class="bento-interactive-card bg-surface-container-lowest rounded-xl p-8 border border-primary-container/10 shadow-sm relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-l-4 hover:border-l-secondary group">
<span class="text-surface-container font-extrabold text-7xl absolute right-6 top-4 select-none pointer-events-none group-hover:text-surface-container-high transition-colors">02</span>
<div class="font-label-sm text-[#da1212] font-bold tracking-wider uppercase mb-4">02 | ACADEMIC QUALIFICATIONS</div>
<!-- Ph.D. Featured Banner -->
<div class="bg-primary-container text-on-primary p-5 rounded-lg border border-secondary/40 shadow-sm mb-4">
<div class="text-[#ffdad5] font-label-sm font-bold tracking-wider uppercase">DOCTOR OF PHILOSOPHY (Ph.D.)</div>
<div class="text-title-lg font-title-lg font-bold text-on-primary mt-1">Human Resource Management</div>
<div class="text-body-md text-on-primary/80 mt-2 font-normal">
                Rigorous research tenure focusing on strategic talent systems, institutional governance, and human capital excellence.
              </div>
</div>
<!-- Credentials Stack -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
<div class="credential-pill bg-surface-container p-3 rounded-lg border border-primary-container/5 transition-all duration-200 hover:border-secondary hover:bg-surface-container-lowest shadow-xs cursor-default">
<div class="text-title-md font-bold text-primary-container">MBA</div>
<div class="text-label-sm text-on-surface-variant mt-0.5">Master of Business Administration</div>
</div>
<div class="credential-pill bg-surface-container p-3 rounded-lg border border-primary-container/5 transition-all duration-200 hover:border-secondary hover:bg-surface-container-lowest shadow-xs cursor-default">
<div class="text-title-md font-bold text-primary-container">M. Com</div>
<div class="text-label-sm text-on-surface-variant mt-0.5">Master of Commerce</div>
</div>
<div class="credential-pill bg-surface-container p-3 rounded-lg border border-primary-container/5 transition-all duration-200 hover:border-secondary hover:bg-surface-container-lowest shadow-xs cursor-default">
<div class="text-title-md font-bold text-primary-container">B. Com (Hons.)</div>
<div class="text-label-sm text-on-surface-variant mt-0.5">Bachelor of Commerce (Honours)</div>
</div>
</div>
</div>
<!-- Card 03 — Areas of Expertise & Interest -->
<div class="bento-interactive-card bg-surface-container-lowest rounded-xl p-8 border border-primary-container/10 shadow-sm relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-l-4 hover:border-l-secondary group">
<span class="text-surface-container font-extrabold text-7xl absolute right-6 top-4 select-none pointer-events-none group-hover:text-surface-container-high transition-colors">03</span>
<div class="font-label-sm text-[#da1212] font-bold tracking-wider uppercase mb-2">03 | AREAS OF EXPERTISE &amp; INTEREST</div>
<h4 class="text-title-lg font-title-lg font-bold text-primary-container mb-4">Core Pedagogical &amp; Executive Domains</h4>
<!-- Interactive Pill Cloud -->
<div class="flex flex-wrap gap-2.5" id="domainPillContainer">
<div class="interactive-tag px-4 py-2.5 rounded-lg bg-surface-container border border-primary-container/10 text-primary-container text-body-md font-semibold cursor-pointer transition-all duration-200 hover:bg-surface-container-lowest hover:border-[#da1212] hover:text-[#da1212] hover:shadow-sm">
                Human Resource Management
              </div>
<div class="interactive-tag px-4 py-2.5 rounded-lg bg-surface-container border border-primary-container/10 text-primary-container text-body-md font-semibold cursor-pointer transition-all duration-200 hover:bg-surface-container-lowest hover:border-[#da1212] hover:text-[#da1212] hover:shadow-sm">
                Marketing &amp; Management
              </div>
<div class="interactive-tag px-4 py-2.5 rounded-lg bg-surface-container border border-primary-container/10 text-primary-container text-body-md font-semibold cursor-pointer transition-all duration-200 hover:bg-surface-container-lowest hover:border-[#da1212] hover:text-[#da1212] hover:shadow-sm">
                Economics
              </div>
<div class="interactive-tag px-4 py-2.5 rounded-lg bg-surface-container border border-primary-container/10 text-primary-container text-body-md font-semibold cursor-pointer transition-all duration-200 hover:bg-surface-container-lowest hover:border-[#da1212] hover:text-[#da1212] hover:shadow-sm">
                Training &amp; Development
              </div>
<div class="interactive-tag px-4 py-2.5 rounded-lg bg-surface-container border border-primary-container/10 text-primary-container text-body-md font-semibold cursor-pointer transition-all duration-200 hover:bg-surface-container-lowest hover:border-[#da1212] hover:text-[#da1212] hover:shadow-sm">
                Research &amp; Academic Writing
              </div>
<div class="interactive-tag px-4 py-2.5 rounded-lg bg-surface-container border border-primary-container/10 text-primary-container text-body-md font-semibold cursor-pointer transition-all duration-200 hover:bg-surface-container-lowest hover:border-[#da1212] hover:text-[#da1212] hover:shadow-sm">
                Student Development
              </div>
<div class="interactive-tag px-4 py-2.5 rounded-lg bg-surface-container border border-primary-container/10 text-primary-container text-body-md font-semibold cursor-pointer transition-all duration-200 hover:bg-surface-container-lowest hover:border-[#da1212] hover:text-[#da1212] hover:shadow-sm">
                Industry–Academia Collaboration
              </div>
</div>
</div>
</div>
</div>
</section>
<!-- ========================================================================= -->
<!-- 4. 4-PILLAR MENTORSHIP IMPACT SECTION (Sticky-Left + Stacking Cards) -->
