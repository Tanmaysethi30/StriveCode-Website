---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Us — StriveCode Technology"
  description="StriveCode Technology - Enterprise Tech, Training & Career Acceleration"
  currentRoute="/aboutus"
  hasGridMatrix={true}
  isHome={false}
>
  <Fragment slot="head">
    <style is:inline>
.architectural-grid {
      background-size: 40px 40px;
      background-image: 
        linear-gradient(to right, rgba(4, 21, 98, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(4, 21, 98, 0.04) 1px, transparent 1px);
    }
    .dark-blueprint-grid {
      background-size: 32px 32px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    }

    /* Core Team Card Mechanics & Scroll Reveal */
    .team-card {
      box-shadow: 0 4px 16px -2px rgba(4, 21, 98, 0.06);
      transition: box-shadow 0.4s ease, border-color 0.4s ease;
    }

    /* Scroll Reveal State (Applied via JS) */
    .sc-reveal-card {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity var(--sc-duration, 0.9s) cubic-bezier(0.22, 1, 0.36, 1) var(--sc-delay, 0s),
                  transform var(--sc-duration, 0.9s) cubic-bezier(0.22, 1, 0.36, 1) var(--sc-delay, 0s),
                  box-shadow 0.4s ease,
                  border-color 0.4s ease;
    }

    .sc-reveal-card.sc-reveal-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .sc-reveal-card.sc-reveal-animating {
      will-change: opacity, transform;
    }

    /* Subtle photo ease from scale 1.06 to 1 on reveal */
    .sc-reveal-card .portrait-img,
    .sc-reveal-card .aspect-\[4\/5\] img {
      transform: scale(1.06);
      transition: transform var(--sc-duration, 0.9s) cubic-bezier(0.22, 1, 0.36, 1) var(--sc-delay, 0s),
                  filter 0.7s ease;
    }

    .sc-reveal-card.sc-reveal-visible .portrait-img,
    .sc-reveal-card.sc-reveal-visible .aspect-\[4\/5\] img {
      transform: scale(1);
    }

    /* Existing Gallery Hover Interactions preserved exactly */
    .team-gallery:hover .team-card:not(:hover) {
      opacity: 0.55;
      transition: opacity 0.5s ease;
    }

    .team-card:hover {
      opacity: 1 !important;
      transform: translateY(-4px) scale(1.02) !important;
      z-index: 10;
      border-color: #DA1212 !important;
      box-shadow: 0 24px 48px -12px rgba(218, 18, 18, 0.16) !important;
    }

    .team-card .portrait-img {
      filter: grayscale(35%);
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.7s ease;
    }

    .team-card:hover .portrait-img {
      filter: grayscale(0%) !important;
      transform: scale(1.05) !important;
    }

    @media (prefers-reduced-motion: reduce) {
      .team-card,
      .sc-reveal-card,
      .sc-reveal-card.sc-reveal-visible {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
        will-change: auto !important;
      }
      .sc-reveal-card .portrait-img,
      .sc-reveal-card .aspect-\[4\/5\] img,
      .sc-reveal-card.sc-reveal-visible .portrait-img,
      .sc-reveal-card.sc-reveal-visible .aspect-\[4\/5\] img {
        transform: none !important;
        transition: none !important;
      }
    }
    </style>
  </Fragment>

  <!-- SECTION 1: Minimalist Parallax Hero Section -->
<section id="sc-about-hero" class="relative min-h-[92vh] flex flex-col justify-center items-center px-6 lg:px-14 py-20 overflow-x-clip" style="background-color: rgb(238, 238, 238); background-image: radial-gradient(rgba(4, 21, 98, 0.1) 1.5px, transparent 1.5px); background-size: 24px 24px; mask-image: linear-gradient(black 70%, transparent 100%);">
<div class="w-full flex flex-col items-center">
  <!-- Two-Column Hero Grid: Left Text, Right 3D Robotic Arm -->
  <div class="w-full grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-8 lg:gap-[clamp(24px,4vw,72px)] items-center mb-10 lg:mb-12">
    <!-- Left Column: Mission DNA Pill, Heading, Subtitle (Strictly Left-aligned) -->
    <div class="flex flex-col items-start text-left w-full">
      <!-- Mission DNA Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-surface-container-lowest border border-primary/15 shadow-sm mb-6">
        <span class="text-secondary font-label-sm uppercase tracking-wider font-bold">OUR MISSION &amp; DNA</span>
      </div>
      <!-- Main Headline -->
      <h1 class="text-primary font-headline-lg md:font-display text-3xl sm:text-5xl md:text-display font-extrabold tracking-tight leading-[1.12] mb-6 text-left">
        Bridging the Gap Between Academic Theory and Tier-1 Production Engineering
      </h1>
      <!-- Subtitle -->
      <p class="text-on-surface-variant font-body-lg text-base sm:text-lg text-left max-w-2xl">
        StriveCode was founded by principal systems architects to solve a singular problem: enterprises need battle-tested engineering pods, and ambitious developers need real-world production rigor.
      </p>
    </div>

    <!-- Right Column: Interactive 3D Robotic Arm Container -->
    <div class="relative w-full flex flex-col items-center overflow-visible">
      <div class="sc-robot-stage relative w-full h-[340px] sm:h-[364px] lg:h-[clamp(444px,calc(52vh+24px),624px)] flex items-center justify-center overflow-visible">
        <!-- Contact Shadow (scales/pulses with arm bob directly under base) -->
        <div id="sc-robot-shadow" class="absolute pointer-events-none rounded-full" style="width: 190px; height: 18px; background: radial-gradient(ellipse at center, rgba(4, 21, 98, 0.32) 0%, rgba(4, 21, 98, 0.1) 45%, transparent 70%); filter: blur(4px); transform-origin: center center;"></div>
        
        <!-- Static Poster WebP (< 60 KB, neutral pose, transparent background) -->
        <img id="sc-robot-poster" src="/assets/models/robot-arm-poster.webp" alt="3D Robotic Arm" class="absolute inset-0 w-full h-full object-contain pointer-events-none" width="600" height="700" loading="eager" decoding="async" />
        
        <!-- Live Three.js Canvas -->
        <canvas id="sc-robot-canvas" class="w-full h-full block opacity-0 pointer-events-none overflow-visible" style="touch-action: pan-y;"></canvas>
      </div>
    </div>
  </div>

  <!-- Floating Architectural Blueprint Card -->
  <div class="w-full max-w-4xl bg-primary text-white rounded-2xl p-6 sm:p-8 shadow-[0_20px_50px_-10px_rgba(4,21,98,0.35)] border border-white/10 dark-blueprint-grid relative overflow-hidden text-left">
<!-- Top Telemetry Status Strip -->
<div class="flex flex-wrap items-center justify-between pb-6 mb-6 border-b border-white/10 gap-3">
<div class="flex items-center gap-2">
<span class="font-label-sm uppercase tracking-widest text-white/80">GLOBAL POD TELEMETRY // REAL-TIME RUNTIME</span>
</div>
<div class="flex items-center gap-2 text-white/60 font-label-sm">
<span>PROD CLUSTERS: VERIFIED STABLE</span>
</div>
</div>
<!-- 4 Core Metrics Grid -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
<div class="border-l-2 border-secondary/70 pl-4">
<div class="text-2xl sm:text-3xl font-extrabold font-headline-md text-white tracking-tight">20,000+</div>
<div class="text-xs uppercase font-label-md tracking-wider text-white/60 mt-1">Engineers Trained</div>
<div class="text-[11px] text-secondary mt-1 font-medium flex items-center gap-1">
<span class="material-symbols-outlined text-[13px]">trending_up</span> Top 1% SRE &amp; Systems
            </div>
</div>
<div class="border-l-2 border-white/20 pl-4">
<div class="text-2xl sm:text-3xl font-extrabold font-headline-md text-white tracking-tight">250+</div>
<div class="text-xs uppercase font-label-md tracking-wider text-white/60 mt-1">Enterprise Releases</div>
<div class="text-[11px] text-white/60 mt-1 font-medium">Bare-Metal Deployments</div>
</div>
<div class="border-l-2 border-white/20 pl-4">
<div class="text-2xl sm:text-3xl font-extrabold font-headline-md text-white tracking-tight">99.8%</div>
<div class="text-xs uppercase font-label-md tracking-wider text-white/60 mt-1">Success Rate</div>
<div class="text-[11px] text-white/60 mt-1 font-medium">Tier-1 Production SLO</div>
</div>
<div class="border-l-2 border-white/20 pl-4">
<div class="text-2xl sm:text-3xl font-extrabold font-headline-md text-white tracking-tight">12+</div>
<div class="text-xs uppercase font-label-md tracking-wider text-white/60 mt-1">Global Hubs</div>
<div class="text-[11px] text-secondary mt-1 font-medium">APAC, EMEA &amp; US Labs</div>
</div>
</div>
</div>
</div>
</section>
<!-- SECTION 2: Split-Screen Sticky Story ('The StriveCode Origin') -->
<section class="py-24 px-6 lg:px-12 max-w-7xl mx-auto border-t border-primary/10">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
<!-- Left Column (Sticky Genesis Anchor) -->
<div class="lg:col-span-5 lg:sticky lg:top-28">
<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-lowest border border-primary/15 shadow-sm mb-4">
<span class="text-secondary font-label-sm uppercase tracking-widest font-bold">OUR GENESIS</span>
</div>
<h2 class="text-primary font-headline-lg text-3xl sm:text-4xl font-bold tracking-tight mb-5 leading-tight">
          Built by Principal Architects, Not Career Theorists
        </h2>
<p class="text-on-surface-variant font-body-md text-base leading-relaxed mb-8">
          The software industry has an open secret: textbook computer science curriculums produce engineers who crumble under high-concurrency production outages. StriveCode was engineered to rebuild technical mastery from the kernel outward.
        </p>
<!-- Vertical accent progress indicator -->
<div class="flex items-center gap-4 p-4 rounded-xl bg-surface-container-lowest border border-primary/10 shadow-sm">
<div class="w-1.5 h-12 bg-secondary rounded-full"></div>
<div>
<div class="text-primary font-title-md font-bold">The Immutable Principle</div>
<div class="text-xs text-on-surface-variant">Real architectures. Real failures. Absolute accountability.</div>
</div>
</div>
</div>
<!-- Right Column (Milestone Cards) -->
<div class="lg:col-span-7 space-y-6">
<!-- Milestone 1 -->
<div class="bg-surface-container-lowest rounded-2xl p-8 border border-primary/10 shadow-[0_4px_16px_-2px_rgba(4,21,98,0.05)] hover:border-primary/25 transition-all">
<div class="flex items-center justify-between mb-4">
<span class="px-3 py-1 bg-surface-container text-primary font-label-sm rounded-lg font-bold">MILESTONE 01</span>
<span class="text-secondary font-headline-sm font-bold">2021</span>
</div>
<h3 class="text-primary font-title-lg text-xl font-bold mb-3">The Production Sandbox Concept</h3>
<p class="text-on-surface-variant font-body-md text-sm leading-relaxed mb-4">
            Founding architects from top multinational cloud firms established hands-on bare-metal sandbox clusters. Instead of abstract toy apps, students managed distributed consensus algorithms under synthesized packet loss and disk degradation.
          </p>
<div class="flex flex-wrap gap-2 text-xs font-label-sm text-primary/70">
<span class="px-2.5 py-1 bg-background rounded border border-primary/5">Bare-Metal Sandboxes</span>
<span class="px-2.5 py-1 bg-background rounded border border-primary/5">Distributed Chaos Drills</span>
</div>
</div>
<!-- Milestone 2 -->
<div class="bg-surface-container-lowest rounded-2xl p-8 border border-primary/10 shadow-[0_4px_16px_-2px_rgba(4,21,98,0.05)] hover:border-primary/25 transition-all">
<div class="flex items-center justify-between mb-4">
<span class="px-3 py-1 bg-surface-container text-primary font-label-sm rounded-lg font-bold">MILESTONE 02</span>
<span class="text-secondary font-headline-sm font-bold">2023</span>
</div>
<h3 class="text-primary font-title-lg text-xl font-bold mb-3">Enterprise Pod Delivery &amp; ISO 9001:2015</h3>
<p class="text-on-surface-variant font-body-md text-sm leading-relaxed mb-4">
            Transitioned from training modules to multi-tenant engineering delivery squads. Attained ISO 9001:2015 quality standards for software delivery pedagogy, partnering directly with Fortune 500 banks to supply turn-key SRE pods.
          </p>
<div class="flex flex-wrap gap-2 text-xs font-label-sm text-primary/70">
<span class="px-2.5 py-1 bg-background rounded border border-primary/5">ISO 9001:2015 Certified</span>
<span class="px-2.5 py-1 bg-background rounded border border-primary/5">Dedicated Delivery Pods</span>
</div>
</div>
<!-- Milestone 3 -->
<div class="bg-surface-container-lowest rounded-2xl p-8 border border-primary/10 shadow-[0_4px_16px_-2px_rgba(4,21,98,0.05)] hover:border-primary/25 transition-all">
<div class="flex items-center justify-between mb-4">
<span class="px-3 py-1 bg-surface-container text-primary font-label-sm rounded-lg font-bold">MILESTONE 03</span>
<span class="text-secondary font-headline-sm font-bold">2026</span>
</div>
<h3 class="text-primary font-title-lg text-xl font-bold mb-3">Global Scale Across 12+ Hubs &amp; 120+ MNC Partners</h3>
<p class="text-on-surface-variant font-body-md text-sm leading-relaxed mb-4">
            Operating sovereign developer research labs and mission-critical cloud pipelines across Bangalore, Agra, Singapore, and London. Fueling sovereign high-throughput AI pipelines and resilient backbones.
          </p>
<div class="flex flex-wrap gap-2 text-xs font-label-sm text-primary/70">
<span class="px-2.5 py-1 bg-background rounded border border-primary/5">120+ MNC Ecosystem</span>
<span class="px-2.5 py-1 bg-background rounded border border-primary/5">Global Mesh Infrastructure</span>
</div>
</div>
</div>
</div>
</section>
<!-- SECTION 3: Core Engineering Philosophy (3-Column Minimalist Grid) -->
<section class="py-24 px-6 lg:px-12 max-w-7xl mx-auto border-t border-primary/10">
<div class="text-center max-w-3xl mx-auto mb-16">
<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-lowest border border-primary/15 shadow-sm mb-4">
<span class="text-secondary font-label-sm uppercase tracking-widest font-bold">ENGINEERING TENETS</span>
</div>
<h2 class="text-primary font-headline-lg text-3xl sm:text-4xl font-bold tracking-tight">
        The Principles That Govern Our Code &amp; Cohorts
      </h2>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
<!-- Card 01 -->
<div class="relative bg-surface-container-lowest rounded-2xl p-8 border border-primary/10 shadow-[0_4px_16px_-2px_rgba(4,21,98,0.05)] hover:border-secondary transition-all group overflow-hidden flex flex-col justify-between">
<div class="absolute -right-4 -top-6 text-[110px] font-black text-background select-none pointer-events-none group-hover:text-primary/5 transition-colors">
          01
        </div>
<div class="relative z-10">
<div class="w-12 h-12 rounded-xl bg-background border border-primary/10 flex items-center justify-center text-secondary mb-6 group-hover:bg-secondary group-hover:text-white transition-colors">
<span class="material-symbols-outlined text-2xl">verified</span>
</div>
<h3 class="text-primary font-title-lg text-xl font-bold mb-3">Zero Technical Debt</h3>
<p class="text-on-surface-variant font-body-md text-sm leading-relaxed">
            Every pipeline mandates rigorous RFC documentation, mutation test thresholds, and architectural consensus before a single commit touches staging. Speed is never bought at the expense of stability.
          </p>
</div>
<div class="mt-8 pt-4 border-t border-primary/5 text-xs font-label-sm text-primary font-semibold flex items-center gap-1">
<span>STRICT RFC COMPLIANCE</span>
<span class="material-symbols-outlined text-[14px]">arrow_forward</span>
</div>
</div>
<!-- Card 02 -->
<div class="relative bg-surface-container-lowest rounded-2xl p-8 border border-primary/10 shadow-[0_4px_16px_-2px_rgba(4,21,98,0.05)] hover:border-secondary transition-all group overflow-hidden flex flex-col justify-between">
<div class="absolute -right-4 -top-6 text-[110px] font-black text-background select-none pointer-events-none group-hover:text-primary/5 transition-colors">
          02
        </div>
<div class="relative z-10">
<div class="w-12 h-12 rounded-xl bg-background border border-primary/10 flex items-center justify-center text-secondary mb-6 group-hover:bg-secondary group-hover:text-white transition-colors">
<span class="material-symbols-outlined text-2xl">dns</span>
</div>
<h3 class="text-primary font-title-lg text-xl font-bold mb-3">Production-First Pedagogy</h3>
<p class="text-on-surface-variant font-body-md text-sm leading-relaxed">
            Zero toy CRUD applications. Engineers execute against multi-region databases, simulate network partitions, deploy telemetry sidecars, and resolve split-brain cluster states in live production environments.
          </p>
</div>
<div class="mt-8 pt-4 border-t border-primary/5 text-xs font-label-sm text-primary font-semibold flex items-center gap-1">
<span>DISTRIBUTED SYSTEMS RIGOR</span>
<span class="material-symbols-outlined text-[14px]">arrow_forward</span>
</div>
</div>
<!-- Card 03 -->
<div class="relative bg-surface-container-lowest rounded-2xl p-8 border border-primary/10 shadow-[0_4px_16px_-2px_rgba(4,21,98,0.05)] hover:border-secondary transition-all group overflow-hidden flex flex-col justify-between">
<div class="absolute -right-4 -top-6 text-[110px] font-black text-background select-none pointer-events-none group-hover:text-primary/5 transition-colors">
          03
        </div>
<div class="relative z-10">
<div class="w-12 h-12 rounded-xl bg-background border border-primary/10 flex items-center justify-center text-secondary mb-6 group-hover:bg-secondary group-hover:text-white transition-colors">
<span class="material-symbols-outlined text-2xl">military_tech</span>
</div>
<h3 class="text-primary font-title-lg text-xl font-bold mb-3">Radical Ownership</h3>
<p class="text-on-surface-variant font-body-md text-sm leading-relaxed">
            Engineers own their code from local architecture draft to incident post-mortems. Direct 1-on-1 critique from Staff and Principal Architects instills unconditional professional integrity.
          </p>
</div>
<div class="mt-8 pt-4 border-t border-primary/5 text-xs font-label-sm text-primary font-semibold flex items-center gap-1">
<span>STAFF-LEVEL MENTORSHIP</span>
<span class="material-symbols-outlined text-[14px]">arrow_forward</span>
</div>
</div>
</div>
</section>
<!-- SECTION 4: Leadership & Core Team Showcase -->
<section class="py-24 px-6 lg:px-12 max-w-7xl mx-auto border-t border-primary/10">
<!-- 1. Section Header -->
<div class="text-center max-w-3xl mx-auto mb-16">
<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-lowest border border-primary/15 shadow-sm mb-4">
