---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Products | StriveCode Technology - Enterprise Technical Infrastructure"
  description="StriveCode Technology - Enterprise Tech, Training & Career Acceleration"
  currentRoute="/product"
  hasGridMatrix={true}
  isHome={false}
>
  <Fragment slot="head">
    <style is:inline>
/* Continuous Marquee Animations */
    @keyframes marquee-left {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }
    @keyframes marquee-right {
      0% { transform: translateX(-50%); }
      100% { transform: translateX(0%); }
    }
    .animate-marquee-left {
      display: flex;
      width: max-content;
      animation: marquee-left 32s linear infinite;
    }
    .animate-marquee-right {
      display: flex;
      width: max-content;
      animation: marquee-right 36s linear infinite;
    }
    .marquee-container:hover .animate-marquee-left,
    .marquee-container:hover .animate-marquee-right {
      animation-play-state: paused;
    }

    /* Subtle Studio Lighting Gradients - semi-transparent to reveal grid matrix background */
    .studio-bg {
      background: radial-gradient(100% 70% at 50% 0%, rgba(255, 255, 255, 0) 0%, rgba(248, 249, 251, 0.1) 50%, rgba(238, 238, 240, 0.5) 100%);
    }

    /* Apple-style Tactile Micro-Interactions with cubic-bezier(0.16, 1, 0.3, 1) */
    .apple-motion {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* 1. Software Bento Card Hover */
    .software-card-interactive {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      border: 2px solid transparent;
      outline: 1px solid rgba(0, 0, 0, 0.04);
    }
    .software-card-interactive:hover {
      transform: translateY(-10px) scale(1.02);
      border-color: #DA1212 !important;
      outline-color: transparent;
      box-shadow: 0 20px 40px -12px rgba(218, 18, 18, 0.18) !important;
    }
    .software-card-interactive:hover .card-icon-box {
      background-color: #DA1212 !important;
      color: #FFFFFF !important;
      box-shadow: 0 8px 16px -4px rgba(218, 18, 18, 0.3);
    }
    .software-card-interactive:hover .card-tag-pill {
      border-color: #DA1212;
      color: #041562;
      background-color: #FFFFFF;
    }

    /* 2. Hero Studio Device Pop-ups & Parallax 3D Base */
    .hero-device-perspective-stage {
      perspective: 1200px;
      perspective-origin: 50% 50%;
      transform-style: preserve-3d;
      overflow: visible;
    }

    .hero-device-interactive {
      border: 2px solid rgba(0, 0, 0, 0.1);
      will-change: transform, opacity, box-shadow;
      transition: transform 0.15s ease-out, opacity 0.2s ease-out, box-shadow 0.2s ease-out;
    }
    .hero-device-interactive:hover {
      border-color: #DA1212 !important;
      z-index: 35;
    }

    /* Sub-pills & website tech capsules */
    .interactive-subpill {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      border: 1.5px solid transparent;
    }
    .interactive-subpill:hover {
      transform: translateY(-3px);
      border-color: #DA1212 !important;
      color: #DA1212 !important;
      background-color: #FFFFFF !important;
      box-shadow: 0 6px 16px -4px rgba(218, 18, 18, 0.15);
    }

    /* 3. Tier Engagement Cards Hover */
    .tier-card-interactive {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      border: 2px solid rgba(0, 0, 0, 0.04);
    }
    .tier-card-interactive:hover {
      transform: translateY(-12px) scale(1.02) !important;
      border-color: #DA1212 !important;
      box-shadow: 0 24px 48px -12px rgba(218, 18, 18, 0.2) !important;
    }
    .tier-card-interactive:hover .tier-action-btn {
      background-color: #DA1212 !important;
      color: #FFFFFF !important;
      border-color: #DA1212 !important;
      box-shadow: 0 8px 18px -4px rgba(218, 18, 18, 0.35);
    }

    /* 4. Client Badges & Testimonial Cards */
    .client-badge-interactive {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      border: 1.5px solid rgba(0, 0, 0, 0.05);
      cursor: default;
    }
    .client-badge-interactive:hover {
      transform: translateY(-6px);
      border-color: #DA1212 !important;
      color: #DA1212 !important;
      box-shadow: 0 10px 20px -6px rgba(218, 18, 18, 0.18);
    }

    .testimonial-card-interactive {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      border: 2px solid rgba(0, 0, 0, 0.04);
    }
    .testimonial-card-interactive:hover {
      transform: translateY(-8px) scale(1.01);
      border-color: #DA1212 !important;
      box-shadow: 0 20px 40px -12px rgba(4, 21, 98, 0.12) !important;
    }

    /* Hero Headline & Highlight Animations for "Today" and "Tomorrow" */
    @property --sc-hl-band-alpha-1 {
      syntax: '<number>';
      inherits: false;
      initial-value: 0.14;
    }

    @property --sc-hl-band-alpha-2 {
      syntax: '<number>';
      inherits: false;
      initial-value: 0.14;
    }

    @supports (text-wrap: balance) {
      section.studio-bg h1 {
        text-wrap: balance;
      }
    }

    .sc-hl {
      display: inline;
      position: relative;
      padding-inline: 0.08em;
      margin-inline: -0.08em;
      border-radius: 0.06em;
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
      cursor: default;
      background-repeat: no-repeat, no-repeat;
      background-size: 200% 0.42em, 100% 0.42em;
      background-position: 250% 86%, 0 86%;
    }

    .sc-hl-1 {
      background-image:
        /* Layer 1: Soft shine stripe sweeping across the band */
        linear-gradient(
          115deg,
          transparent 0%,
          transparent 35%,
          rgba(255, 255, 255, 0.65) 50%,
          transparent 65%,
          transparent 100%
        ),
        /* Layer 2: Soft red marker band */
        linear-gradient(
          rgba(218, 18, 18, var(--sc-hl-band-alpha-1, 0.14)),
          rgba(218, 18, 18, var(--sc-hl-band-alpha-1, 0.14))
        );
    }

    .sc-hl-2 {
      background-image:
        /* Layer 1: Soft shine stripe sweeping across the band */
        linear-gradient(
          115deg,
          transparent 0%,
          transparent 35%,
          rgba(255, 255, 255, 0.65) 50%,
          transparent 65%,
          transparent 100%
        ),
        /* Layer 2: Soft red marker band */
        linear-gradient(
          rgba(218, 18, 18, var(--sc-hl-band-alpha-2, 0.14)),
          rgba(218, 18, 18, var(--sc-hl-band-alpha-2, 0.14))
        );
    }

    .sc-hl-text {
      display: inline;
      color: #DA1212;
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
    }

    @media (prefers-reduced-motion: no-preference) {
      body.site-loaded .sc-hl {
        transition: background-size 0.5s cubic-bezier(0.22, 1, 0.36, 1);
      }

      @media (hover: hover) and (pointer: fine) {
        .sc-hl:hover {
          background-size: 200% 1.15em, 100% 1.15em;
        }
      }

      body.site-loaded .sc-hl-1 {
        animation:
          sc-hl-band-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.7s backwards,
          sc-hl-band-shine 8s ease-in-out 2.2s infinite,
          sc-hl-band-breathe-1 5.5s ease-in-out 1.8s infinite;
      }

      body.site-loaded .sc-hl-1 .sc-hl-text {
        animation: sc-hl-text-color 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.7s backwards;
      }

      body.site-loaded .sc-hl-2 {
        animation:
          sc-hl-band-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) 1.3s backwards,
          sc-hl-band-shine 8s ease-in-out 6.2s infinite,
          sc-hl-band-breathe-2 5.5s ease-in-out 3.5s infinite;
      }

      body.site-loaded .sc-hl-2 .sc-hl-text {
        animation: sc-hl-text-color 0.8s cubic-bezier(0.22, 1, 0.36, 1) 1.3s backwards;
      }
    }

    @keyframes sc-hl-band-in {
      0% {
        background-size: 200% 0.42em, 0% 0.42em;
      }
      100% {
        background-size: 200% 0.42em, 100% 0.42em;
      }
    }

    @keyframes sc-hl-band-shine {
      0% {
        background-position: 250% 86%, 0 86%;
      }
      20% {
        background-position: -150% 86%, 0 86%;
      }
      100% {
        background-position: -150% 86%, 0 86%;
      }
    }

    @keyframes sc-hl-band-breathe-1 {
      0%, 100% {
        --sc-hl-band-alpha-1: 0.12;
      }
      50% {
        --sc-hl-band-alpha-1: 0.16;
      }
    }

    @keyframes sc-hl-band-breathe-2 {
      0%, 100% {
        --sc-hl-band-alpha-2: 0.12;
      }
      50% {
        --sc-hl-band-alpha-2: 0.16;
      }
    }

    @keyframes sc-hl-text-color {
      0% {
        color: #041562;
      }
      100% {
        color: #DA1212;
      }
    }
    </style>
  </Fragment>

  <!-- =========================================================================
