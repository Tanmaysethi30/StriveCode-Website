<!-- Card 01 -->
<div class="group bg-surface-container-lowest p-8 rounded-2xl border border-outline-variant/30 hover:border-[#DA1212]/40 shadow-sm hover:shadow-2xl transition-all duration-300 relative overflow-hidden hover:-translate-y-2 border-t-2 border-t-primary-container hover:border-t-secondary-container">
