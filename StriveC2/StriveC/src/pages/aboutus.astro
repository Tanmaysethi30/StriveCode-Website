<span class="block text-lg font-bold text-[#DA1212] mt-1">Director</span>
</div>
<p class="italic text-xl text-[#EEEEEE] leading-relaxed font-light border-l-2 border-[#DA1212] pl-4 my-2">
          "We don't just write code, we build the future."
        </p>
<div class="flex flex-wrap gap-2 pt-2">
<span class="px-3 py-1 bg-white/10 text-xs rounded-full text-white/80 border border-white/10">Strategic Vision</span>
<span class="px-3 py-1 bg-white/10 text-xs rounded-full text-white/80 border border-white/10">Enterprise Governance</span>
<span class="px-3 py-1 bg-white/10 text-xs rounded-full text-white/80 border border-white/10">Ecosystem Architecture</span>
</div>
</div>
</div>
</div>
<!-- 3. The 15 Core Team Gallery Grid -->
<div class="team-gallery grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
<!-- Member 01: Nishita Tiwari -->
<div class="team-card bg-[#FFFFFF] rounded-2xl p-5 border border-primary/10 shadow-[0_4px_16px_-2px_rgba(4,21,98,0.06)] flex flex-col justify-between group cursor-default is-revealed">
<div>
<div class="rounded-[18px] overflow-hidden bg-slate-100 aspect-[4/5] w-full mb-4">
<img alt="Nishita Tiwari, Business Consultant" class="portrait-img w-full h-full object-cover" style="object-position: center top;" width="358" height="370" loading="lazy" decoding="async" src="/assets/members/nishtha-tiwari.png">
