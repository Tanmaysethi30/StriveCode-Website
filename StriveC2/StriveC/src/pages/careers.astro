---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Careers | StriveCode Technology"
  description="StriveCode Technology - Enterprise Tech, Training & Career Acceleration"
  currentRoute="/careers"
  hasGridMatrix={true}
  isHome={false}
>
  <Fragment slot="head">
    <style is:inline>
.material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: normal;
      font-style: normal;
      font-size: 24px;
      line-height: 1;
      letter-spacing: normal;
      text-transform: none;
      display: inline-block;
      white-space: nowrap;
      word-wrap: normal;
      direction: ltr;
      -webkit-font-smoothing: antialiased;
    }
    .custom-bento-card {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .custom-bento-card:hover {
      transform: translateY(-10px) scale(1.02);
      border-color: #DA1212;
      box-shadow: 0 20px 32px -8px rgba(4, 21, 98, 0.12);
    }
    .custom-role-card {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .custom-role-card:hover {
      transform: translateY(-8px) scale(1.01);
      border-color: #DA1212;
      box-shadow: 0 16px 28px -6px rgba(4, 21, 98, 0.10);
    }
    .apply-cta-btn {
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .apply-cta-btn:hover {
      transform: translateY(-2px) scale(1.04);
      box-shadow: 0 10px 24px -6px rgba(218, 18, 18, 0.45);
    }

    /* StriveCode Hero Tagline - "Future" Highlight & Animation */
    .sc-future {
      position: relative;
      display: inline;
      isolation: isolate;
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
      color: #DA1212;
      cursor: default;
    }

    .sc-future::before {
      content: '';
      position: absolute;
      left: -0.08em;
      right: -0.08em;
      bottom: 0.08em;
      height: 0.50em;
      background-color: rgba(218, 18, 18, 0.14);
      border-radius: 4px;
      z-index: -1;
      transform-origin: left center;
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
      pointer-events: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      .sc-future {
        background-image: linear-gradient(
          115deg,
          #DA1212 0%,
          #DA1212 38%,
          rgba(255, 255, 255, 0.82) 48%,
          rgba(255, 210, 210, 0.9) 52%,
          #DA1212 62%,
          #DA1212 100%
        );
        background-size: 260% 100%;
        background-position: 100% 0;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: 
          sc-future-color-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.7s backwards,
          sc-future-shine 7.6s ease-in-out 2.6s infinite;
      }

      .sc-future::before {
        transform: scaleX(0);
        transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1), bottom 0.5s cubic-bezier(0.22, 1, 0.36, 1);
        animation:
          sc-future-band-in 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.7s forwards,
          sc-future-band-breathe 5.5s ease-in-out 1.9s infinite;
      }

      @media (hover: hover) and (pointer: fine) {
        .sc-future:hover::before {
          height: 1.04em;
          bottom: 0em;
        }
      }
    }

    @keyframes sc-future-color-in {
      0% {
        -webkit-text-fill-color: #041562;
        color: #041562;
      }
      100% {
        -webkit-text-fill-color: transparent;
        color: #DA1212;
      }
    }

    @keyframes sc-future-shine {
      0% {
        background-position: 100% 0;
      }
      21.3% {
        background-position: -60% 0;
      }
      100% {
        background-position: -60% 0;
      }
    }

    @keyframes sc-future-band-in {
      0% {
        transform: scaleX(0);
      }
      100% {
        transform: scaleX(1);
      }
    }

    @keyframes sc-future-band-breathe {
      0%, 100% {
        opacity: 0.85;
      }
      50% {
        opacity: 1;
      }
    }
    </style>
  </Fragment>

