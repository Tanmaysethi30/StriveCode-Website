      chips: ['CI/CD Rollouts', 'Technical Defense', 'Partner Referrals'],
      output: 'Output: Live Production Release & Enterprise Referral',
      duration: 'Duration: Weeks 19-24',
      cluster: 'cluster:deployment-placement.metrics',
      podBadge: 'Placement Pod',
      m1: { label: 'PLACEMENT ALIGNMENT', target: 100, suffix: '%', decimals: 0, sub: 'Enterprise Tier Pipeline' },
      m2: { label: 'PRODUCTION PODS', target: 42, suffix: ' Pods', decimals: 0, sub: 'Zero Downtime Deploy' },
      squad: { title: 'Career Accelerator Pod', sub: 'Direct Referral Active', status: 'Hiring Loop Open' },
      progress: { label: 'Cohort Placement Readiness', val: '100% Placement', pct: 100 }
    }
  };

  const container = document.getElementById('stage-nodes-container');
  const pane = document.getElementById('stage-tabpanel');
  const progressBar = document.getElementById('stage-progress-bar');
  const stageSection = document.getElementById('stage-methodology');

  if (!container || !pane) return;

  let currentStage = 1;
  let transitionTimer = null;
  const activeAnimationFrames = [];

  function cancelNumberAnimations() {
    while (activeAnimationFrames.length > 0) {
      cancelAnimationFrame(activeAnimationFrames.pop());
    }
  }

  function animateNumber(element, target, suffix, decimals, duration) {
    if (!element) return;
    if (reducedMotion) {
      element.textContent = (decimals ? target.toFixed(decimals) : Math.round(target)) + suffix;
      return;
    }
    const startTime = performance.now();
    function update(currentTime) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const ease = 1 - Math.pow(1 - progress, 3);
      const currentVal = progress >= 1 ? target : (target * ease);
      element.textContent = (decimals ? currentVal.toFixed(decimals) : Math.round(currentVal)) + suffix;
      if (progress < 1) {
        const id = requestAnimationFrame(update);
        activeAnimationFrames.push(id);
      }
    }
    const id = requestAnimationFrame(update);
    activeAnimationFrames.push(id);
  }

  function animateProgressBar(barElement, targetPercent, duration) {
    if (!barElement) return;
    if (reducedMotion) {
      barElement.style.width = targetPercent + '%';
      return;
    }
    barElement.style.transition = 'none';
    barElement.style.width = '0%';
    void barElement.offsetWidth;
    barElement.style.transition = 'width ' + duration + 'ms cubic-bezier(0.22, 1, 0.36, 1)';
    barElement.style.width = targetPercent + '%';
  }

  function updateTabs(activeNum) {
    const tabs = container.querySelectorAll('.stage-node');
    tabs.forEach(tab => {
      const stage = parseInt(tab.getAttribute('data-stage'), 10);
      const badge = tab.querySelector('.node-badge');
      const title = tab.querySelector('.node-title');
      const isActive = stage === activeNum;

      tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      tab.setAttribute('tabindex', isActive ? '0' : '-1');

      if (isActive) {
        tab.className = 'stage-node group flex flex-col items-center text-center p-3 rounded-xl border transition-all duration-200 bg-white border-[#DA1212] shadow-md ring-2 ring-[#DA1212]/20 cursor-pointer min-w-[150px] sm:min-w-[170px] md:min-w-0 flex-1 shrink-0 md:shrink is-active';
        if (badge) {
          badge.className = 'node-badge w-10 h-10 rounded-full bg-[#DA1212] text-white font-mono font-bold flex items-center justify-center text-sm shadow-md shadow-[#DA1212]/25 transition-colors mb-2';
        }
        if (title) {
          title.className = 'node-title text-xs font-bold text-[#DA1212] transition-colors leading-tight';
        }
      } else {
        tab.className = 'stage-node group flex flex-col items-center text-center p-3 rounded-xl border transition-all duration-200 bg-white border-[#e0e0e0] hover:border-[#DA1212] hover:shadow-md cursor-pointer min-w-[150px] sm:min-w-[170px] md:min-w-0 flex-1 shrink-0 md:shrink';
        if (badge) {
          badge.className = 'node-badge w-10 h-10 rounded-full bg-[#EEEEEE] text-[#041562] font-mono font-bold flex items-center justify-center text-sm shadow-xs transition-colors mb-2 group-hover:bg-[#041562] group-hover:text-white';
        }
        if (title) {
          title.className = 'node-title text-xs font-semibold text-[#1b254b] group-hover:text-[#DA1212] transition-colors leading-tight';
        }
      }
    });
  }

  function updateConnector(activeNum) {
    if (progressBar) {
      progressBar.style.width = ((activeNum - 1) * 25) + '%';
    }
  }

  function renderStageContent(stageNum) {
    const data = STAGE_DATA[stageNum];
    if (!data) return;

    pane.setAttribute('aria-labelledby', 'stage-tab-' + stageNum);

    const badge = document.getElementById('stage-badge');
    if (badge) badge.textContent = data.badge;

    const title = document.getElementById('stage-title');
    if (title) title.textContent = data.title;

    const desc = document.getElementById('stage-desc');
    if (desc) desc.textContent = data.desc;

    const chipsContainer = document.getElementById('stage-chips');
    if (chipsContainer) {
      chipsContainer.innerHTML = data.chips.map(chip =>
        '<span class="px-3 py-1.5 rounded-lg bg-[#EEEEEE] text-[#041562] text-xs font-mono font-medium border border-[#041562]/20">' + chip + '</span>'
      ).join('');
    }

    const output = document.getElementById('stage-output');
    if (output) output.textContent = data.output;

    const duration = document.getElementById('stage-duration');
    if (duration) duration.textContent = data.duration;

    const cluster = document.getElementById('stage-cluster');
    if (cluster) {
      cluster.innerHTML = '<span class="material-symbols-outlined text-sm">bolt</span> ' + data.cluster;
    }

    const podBadge = document.getElementById('stage-pod-badge');
    if (podBadge) podBadge.textContent = data.podBadge;

    const m1Label = document.getElementById('stage-m1-label');
    if (m1Label) m1Label.textContent = data.m1.label;
    const m1Val = document.getElementById('stage-m1-val');
    if (m1Val) m1Val.textContent = data.m1.target + data.m1.suffix;
    const m1Sub = document.getElementById('stage-m1-sub');
    if (m1Sub) m1Sub.textContent = data.m1.sub;

    const m2Label = document.getElementById('stage-m2-label');
    if (m2Label) m2Label.textContent = data.m2.label;
    const m2Val = document.getElementById('stage-m2-val');
    if (m2Val) m2Val.textContent = data.m2.target + data.m2.suffix;
    const m2Sub = document.getElementById('stage-m2-sub');
    if (m2Sub) m2Sub.textContent = data.m2.sub;

    const squadTitle = document.getElementById('stage-squad-title');
    if (squadTitle) squadTitle.textContent = data.squad.title;
    const squadSub = document.getElementById('stage-squad-sub');
    if (squadSub) squadSub.textContent = data.squad.sub;
    const squadStatus = document.getElementById('stage-squad-status');
    if (squadStatus) squadStatus.textContent = data.squad.status;

    const progressLabel = document.getElementById('stage-progress-label');
    if (progressLabel) progressLabel.textContent = data.progress.label;
    const progressVal = document.getElementById('stage-progress-val');
    if (progressVal) progressVal.textContent = data.progress.val;
  }

  function triggerAnimations(stageNum) {
    cancelNumberAnimations();
    const data = STAGE_DATA[stageNum];
    if (!data) return;

    const m1Val = document.getElementById('stage-m1-val');
    animateNumber(m1Val, data.m1.target, data.m1.suffix, data.m1.decimals || 0, 750);

    const m2Val = document.getElementById('stage-m2-val');
    animateNumber(m2Val, data.m2.target, data.m2.suffix, data.m2.decimals || 0, 750);

    const progressFill = document.getElementById('stage-progress-fill');
    animateProgressBar(progressFill, data.progress.pct, 700);
  }

  function scrollTabIntoViewOnMobile(stageNum) {
    const activeTab = container.querySelector('[data-stage="' + stageNum + '"]');
    if (!activeTab) return;
    if (container.scrollWidth > container.clientWidth) {
      const targetLeft = activeTab.offsetLeft - (container.clientWidth - activeTab.clientWidth) / 2;
      container.scrollTo({ left: Math.max(0, targetLeft), behavior: 'smooth' });
    }
  }

  function setActiveStage(stageNum, immediate) {
    if (stageNum === currentStage && !immediate) return;
    const isNext = stageNum > currentStage;
    currentStage = stageNum;

    updateTabs(currentStage);
    updateConnector(currentStage);

    if (immediate || reducedMotion) {
      if (transitionTimer) clearTimeout(transitionTimer);
      renderStageContent(currentStage);
      pane.style.transition = 'none';
      pane.style.transform = 'none';
      pane.style.opacity = '1';
      triggerAnimations(currentStage);
      return;
    }

    if (transitionTimer) clearTimeout(transitionTimer);

    // Directional slide out
    pane.style.transition = 'transform 200ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms cubic-bezier(0.4, 0, 0.2, 1)';
    pane.style.transform = isNext ? 'translateX(-24px)' : 'translateX(24px)';
    pane.style.opacity = '0';

    transitionTimer = setTimeout(() => {
      renderStageContent(currentStage);
      pane.style.transition = 'none';
      pane.style.transform = isNext ? 'translateX(24px)' : 'translateX(-24px)';
      pane.style.opacity = '0';
      void pane.offsetWidth; // force reflow

      // Directional slide in
      pane.style.transition = 'transform 300ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms cubic-bezier(0.16, 1, 0.3, 1)';
      pane.style.transform = 'translateX(0)';
      pane.style.opacity = '1';

      triggerAnimations(currentStage);
      transitionTimer = null;
    }, 200);
  }

  // User tab click
  container.addEventListener('click', (e) => {
    const btn = e.target.closest('.stage-node');
    if (!btn) return;
    const targetStage = parseInt(btn.getAttribute('data-stage'), 10);
    if (!isNaN(targetStage)) {
      setActiveStage(targetStage, false);
      restartAutoAdvance();
      scrollTabIntoViewOnMobile(targetStage);
    }
  });

  // Keyboard navigation
  container.addEventListener('keydown', (e) => {
    const currentTab = document.activeElement ? document.activeElement.closest('.stage-node') : null;
    if (!currentTab) return;
    const stage = parseInt(currentTab.getAttribute('data-stage'), 10);
    let targetStage = null;

    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      e.preventDefault();
      targetStage = stage >= 5 ? 1 : stage + 1;
    } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
      e.preventDefault();
      targetStage = stage <= 1 ? 5 : stage - 1;
    } else if (e.key === 'Home') {
      e.preventDefault();
      targetStage = 1;
    } else if (e.key === 'End') {
      e.preventDefault();
      targetStage = 5;
    } else if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      targetStage = stage;
    }

    if (targetStage !== null) {
      const nextTab = container.querySelector('[data-stage="' + targetStage + '"]');
      if (nextTab) {
        nextTab.focus({ preventScroll: true });
      }
      setActiveStage(targetStage, false);
      restartAutoAdvance();
      scrollTabIntoViewOnMobile(targetStage);
    }
  });

  // Auto-advance logic (6.5 seconds)
  const AUTO_ADVANCE_DELAY = 6500;
  let autoTimer = null;
  let isHovered = false;
  let isFocused = false;
  let isVisible = false;

  function autoAdvanceTick() {
    if (isHovered || isFocused || !isVisible || document.hidden) return;
    const nextStage = currentStage >= 5 ? 1 : currentStage + 1;
    setActiveStage(nextStage, false);
    scrollTabIntoViewOnMobile(nextStage);
  }

  function startAutoAdvance() {
    stopAutoAdvance();
    autoTimer = setInterval(autoAdvanceTick, AUTO_ADVANCE_DELAY);
  }

  function stopAutoAdvance() {
    if (autoTimer) {
      clearInterval(autoTimer);
      autoTimer = null;
    }
  }

  function restartAutoAdvance() {
    stopAutoAdvance();
    startAutoAdvance();
  }

  if (stageSection) {
    stageSection.addEventListener('pointerenter', () => {
      isHovered = true;
      stopAutoAdvance();
    });
    stageSection.addEventListener('pointerleave', () => {
      isHovered = false;
      startAutoAdvance();
    });
    stageSection.addEventListener('focusin', () => {
      isFocused = true;
      stopAutoAdvance();
    });
    stageSection.addEventListener('focusout', (e) => {
      if (!stageSection.contains(e.relatedTarget)) {
        isFocused = false;
        startAutoAdvance();
      }
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          isVisible = entry.isIntersecting;
          if (isVisible && !isHovered && !isFocused && !document.hidden) {
            startAutoAdvance();
          } else {
            stopAutoAdvance();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(stageSection);
    } else {
      isVisible = true;
      startAutoAdvance();
    }
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopAutoAdvance();
    } else if (isVisible && !isHovered && !isFocused) {
      startAutoAdvance();
    }
  });

  // Initial trigger for stage 1 (without scroll or layout jumps)
  triggerAnimations(1);
})();
    </script>
    <script is:inline id="sc-loader-script">
(function() {
  const overlay = document.getElementById('scLoaderOverlay');
  const pageContent = document.getElementById('sc-loader-page');
  if (!overlay) return;

  let isRunning = false;
  let exitScheduledTimer = null;
  let maxTimer = null;
  let safetyTimer = null;
  let fadeCleanupTimer = null;

  function clearAllTimers() {
    if (exitScheduledTimer) { clearTimeout(exitScheduledTimer); exitScheduledTimer = null; }
    if (maxTimer) { clearTimeout(maxTimer); maxTimer = null; }
    if (safetyTimer) { clearTimeout(safetyTimer); safetyTimer = null; }
    if (fadeCleanupTimer) { clearTimeout(fadeCleanupTimer); fadeCleanupTimer = null; }
  }

  function startLoader() {
    if (isRunning) return;
    isRunning = true;
    clearAllTimers();

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const minDisplayTime = reducedMotion ? 1000 : 1800;
    const maxDisplayTime = 3000;
    const safetyCutoffTime = 4000;
    const startTime = Date.now();

    // 1. Lock scroll
    document.documentElement.classList.add('sc-loader-lock');

    // 2. Reset Page Content (hide behind overlay with gentle 12px offset)
    if (pageContent) {
      pageContent.classList.remove('sc-loader-revealed');
      pageContent.style.opacity = '';
      pageContent.style.transform = '';
      pageContent.style.willChange = '';
    }

    // 3. Reset Overlay
    overlay.classList.remove('sc-loader-exit');
    overlay.style.display = 'flex';
    overlay.style.opacity = '';
    overlay.style.pointerEvents = '';
    overlay.removeAttribute('aria-hidden');

    // 4. Replay Keyframe Animations (restart entrance, pulse, sweep, progress fill from 0)
    const logoWrap = overlay.querySelector('.sc-loader-logo-wrap');
    if (logoWrap) {
      const newLogoWrap = logoWrap.cloneNode(true);
      logoWrap.parentNode.replaceChild(newLogoWrap, logoWrap);
    }
    const track = overlay.querySelector('.sc-loader-track');
    if (track) {
      const newTrack = track.cloneNode(true);
      track.parentNode.replaceChild(newTrack, track);
    }

    let isExiting = false;

    function triggerExit() {
      if (isExiting) return;
      isExiting = true;
      clearAllTimers();

      overlay.classList.add('sc-loader-exit');
      if (pageContent) {
        pageContent.classList.add('sc-loader-revealed');
      }

      const fadeDuration = reducedMotion ? 400 : 900;
      fadeCleanupTimer = setTimeout(function() {
        overlay.style.display = 'none';
        overlay.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('sc-loader-lock');
        if (pageContent) {
          pageContent.style.transform = 'none';
          pageContent.style.willChange = 'auto';
        }
        isRunning = false;

        if (!window.location.hash) {
          window.scrollTo(0, 0);
        }

        window.dispatchEvent(new Event('scroll'));
        window.dispatchEvent(new Event('resize'));
      }, fadeDuration);
    }

    function scheduleExit() {
      const elapsed = Date.now() - startTime;
      const remaining = Math.max(0, minDisplayTime - elapsed);
      exitScheduledTimer = setTimeout(triggerExit, remaining);
    }

    if (document.readyState === 'complete') {
      scheduleExit();
    } else {
      window.addEventListener('load', function() {
        scheduleExit();
      }, { once: true });
    }

    // Normal max timeout (3s)
    maxTimer = setTimeout(function() {
      if (!isExiting) {
        triggerExit();
      }
    }, maxDisplayTime);

    // Hard safety timeout (4s) - guarantees removal even if window load event is delayed/stalled
    safetyTimer = setTimeout(function() {
      if (!isExiting) {
        triggerExit();
      }
    }, safetyCutoffTime);
  }

  // Initial Run on page load
  startLoader();

  // Handle Browser Back/Forward Cache (bfcache)
  window.addEventListener('pageshow', function(event) {
    if (!window.location.hash) {
      window.scrollTo(0, 0);
    }
    if (event.persisted) {
      isRunning = false;
      startLoader();
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    if (!window.location.hash) {
      window.scrollTo(0, 0);
    }
  });
})();
    </script>
  </Fragment>
</BaseLayout>
