---
import BaseLayout from '../layouts/BaseLayout.astro';
import InternTestimonials from '../components/InternTestimonials.astro';
---

<BaseLayout
  title="StriveCode Technology - Enterprise Tech, Training &amp; Career Acceleration"
  description="StriveCode Technology - Enterprise Tech, Training & Career Acceleration"
  currentRoute="/"
  hasGridMatrix={true}
  isHome={true}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/intern-testimonials.css" />
    <style is:inline>
      .reveal {
        opacity: 0;
        transform: translateY(25px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }
      .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
      }

      @keyframes marqueeLeft {
        0% { transform: translateX(0%); }
        100% { transform: translateX(-50%); }
      }
      @keyframes marqueeRight {
        0% { transform: translateX(-50%); }
        100% { transform: translateX(0%); }
      }

      .animate-marquee-left {
        display: flex;
        width: max-content;
        animation: marqueeLeft 32s linear infinite;
      }
      .animate-marquee-right {
        display: flex;
        width: max-content;
        animation: marqueeRight 35s linear infinite;
      }
      .pause-hover:hover {
        animation-play-state: paused;
      }

      /* Stacked Card Deck Fan-Out Gallery */
      .sc-deck-wrapper {
        position: relative;
        width: 100%;
      }
      .sc-deck {
        position: relative;
        width: 100%;
      }
      .sc-deck-grid {
        position: relative;
        width: 100%;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
        max-width: 360px;
        margin: 0 auto;
        padding: 0;
        list-style: none;
      }
      @media (min-width: 640px) {
        .sc-deck-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          max-width: 100%;
        }
      }
      @media (min-width: 1024px) {
        .sc-deck-grid {
          grid-template-columns: repeat(4, minmax(0, 1fr));
          max-width: 100%;
        }
      }
      .sc-deck-card {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 5;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(4, 21, 98, 0.10);
        box-shadow: 0 10px 25px -5px rgba(4, 21, 98, 0.08), 0 8px 10px -6px rgba(4, 21, 98, 0.04);
        background-color: #041562;
        cursor: pointer;
        transform: translate3d(0, 0, 0) rotate(0deg);
      }
      .sc-deck-card picture,
      .sc-deck-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      /* Stacked State (Active when JavaScript is loaded and not reduced-motion) */
      .sc-deck-ready .sc-deck-card {
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        transform: translate3d(var(--sx, 0px), calc(var(--sy, 0px) + var(--dy, 0px)), 0) rotate(var(--rot, 0deg));
        z-index: var(--z, 1);
      }

      /* Collapse Stagger: Card 4 (0ms), Card 3 (50ms), Card 2 (100ms), Card 1 (150ms) */
      .sc-deck-ready:not(.sc-deck-fanned) .sc-deck-card:nth-child(4) { transition-delay: 0ms; }
      .sc-deck-ready:not(.sc-deck-fanned) .sc-deck-card:nth-child(3) { transition-delay: 50ms; }
      .sc-deck-ready:not(.sc-deck-fanned) .sc-deck-card:nth-child(2) { transition-delay: 100ms; }
      .sc-deck-ready:not(.sc-deck-fanned) .sc-deck-card:nth-child(1) { transition-delay: 150ms; }

      /* Fanned State (Hover, Focus, or Touch Intersection) */
      .sc-deck-ready.sc-deck-fanned .sc-deck-card,
      .sc-deck-ready:focus-within .sc-deck-card {
        transform: translate3d(0, 0, 0) rotate(0deg);
      }

      /* Fan-Out Stagger: Card 1 (0ms), Card 2 (50ms), Card 3 (100ms), Card 4 (150ms) */
      .sc-deck-ready.sc-deck-fanned .sc-deck-card:nth-child(1),
      .sc-deck-ready:focus-within .sc-deck-card:nth-child(1) { transition-delay: 0ms; }
      .sc-deck-ready.sc-deck-fanned .sc-deck-card:nth-child(2),
      .sc-deck-ready:focus-within .sc-deck-card:nth-child(2) { transition-delay: 50ms; }
      .sc-deck-ready.sc-deck-fanned .sc-deck-card:nth-child(3),
      .sc-deck-ready:focus-within .sc-deck-card:nth-child(3) { transition-delay: 100ms; }
      .sc-deck-ready.sc-deck-fanned .sc-deck-card:nth-child(4),
      .sc-deck-ready:focus-within .sc-deck-card:nth-child(4) { transition-delay: 150ms; }

      /* will-change optimization during active animation */
      .sc-deck-animating .sc-deck-card {
        will-change: transform;
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
        .animate-marquee-left,
        .animate-marquee-right {
          animation: none !important;
          transform: none !important;
        }
        .sc-deck-ready .sc-deck-card {
          transition: none !important;
          transform: none !important;
        }
      }
    </style>
  </Fragment>

  <div id="home">
<!-- 2. HERO SECTION -->
<section class="relative py-16 lg:py-24 w-full" style="overflow-x: clip;">
<!-- Full-bleed background decorative layer (spanning 100% viewport width) -->
<div class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <!-- Symmetric, full-bleed centered bluish-grey ambient wash -->
  <div class="absolute inset-0 w-full h-full" style="background: radial-gradient(ellipse 85% 70% at 50% 45%, rgba(4, 21, 98, 0.06) 0%, rgba(4, 21, 98, 0.02) 55%, transparent 80%);"></div>

  <!-- Full-bleed diagonal light streak, smoothly fading to transparent at all edges -->
  <div class="absolute inset-0 w-full h-full" style="background: linear-gradient(125deg, transparent 0%, transparent 28%, rgba(255, 255, 255, 0) 36%, rgba(255, 255, 255, 0.22) 47%, rgba(255, 255, 255, 0.35) 50%, rgba(255, 255, 255, 0.22) 53%, rgba(255, 255, 255, 0) 64%, transparent 72%, transparent 100%); mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, black 40%, transparent 95%); -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, black 40%, transparent 95%);"></div>

  <!-- Soft, balanced ambient radial glows on left & right for natural depth -->
  <div class="absolute top-1/4 left-1/2 -translate-x-[550px] -translate-y-1/2 w-[500px] h-[450px] bg-[#041562]/[0.05] rounded-full blur-[100px]"></div>
  <div class="absolute top-1/4 left-1/2 translate-x-[50px] -translate-y-1/2 w-[500px] h-[450px] bg-[#041562]/[0.05] rounded-full blur-[100px]"></div>
</div>

<!-- Content Container (preserves exact dimensions, padding, and centered alignment) -->
<div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
<!-- Left Column -->
<div class="lg:col-span-7 flex flex-col gap-6 reveal revealed" style="transition-delay: 0s;">
<div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[#EEEEEE] border border-[#041562]/20 w-fit shadow-xs">
<span class="text-xs font-semibold text-[#041562] tracking-wide uppercase font-mono">Next-Gen Tech &amp; Career Ecosystem</span>
</div>
<h1 class="font-display font-extrabold text-[38px] sm:text-[46px] lg:text-[56px] leading-[1.12] text-[#041562] tracking-tight">
  Engineering Digital Excellence &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#041562] via-[#041562] to-[#112d96]">Future Tech Leaders</span>
</h1>
<p class="text-[#2a3556] text-lg sm:text-[19px] leading-relaxed max-w-2xl font-normal">
  StriveCode delivers world-class enterprise software delivery, hands-on production engineering labs, and elite 1-on-1 cohort career accelerators built to transform aspiring coders into principal industry architects.
</p>
<div class="flex flex-wrap items-center gap-y-3 gap-x-8 pt-6 mt-2 border-t border-[#041562]/15 text-xs sm:text-sm font-medium text-[#2a3556]">
<div class="flex items-center gap-1.5"><span class="font-semibold text-[#041562]">ISO Certified</span></div>
<div class="flex items-center gap-1.5"><span class="font-semibold text-[#041562]">1-on-1 Industry Mentorship</span></div>
<div class="flex items-center gap-1.5"><span class="font-semibold text-[#041562]">99.8% Client &amp; Student Satisfaction</span></div>
</div>
</div>
<!-- Right Column -->
<div class="lg:col-span-5 relative reveal revealed" style="transition-delay: 0.1s;">
<!-- Soft pink/red glow centered softly behind the hero card -->
<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 sm:w-96 h-80 sm:h-96 bg-[#DA1212]/10 rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>
<div class="relative group">
<div class="rounded-3xl relative overflow-hidden p-6 sm:p-8 shadow-2xl bg-gradient-to-br from-[#020b30] via-[#041562] to-[#01081e] border border-[#041562]/40">
<div class="absolute -top-16 -right-16 w-56 h-56 rounded-full bg-[#DA1212]/20 blur-3xl pointer-events-none"></div>
<div class="absolute -bottom-16 -left-16 w-56 h-56 rounded-full bg-[#041562]/30 blur-3xl pointer-events-none"></div>
<div class="relative z-10 backdrop-blur-md bg-[#020b30]/95 rounded-2xl border border-blue-900/60 shadow-2xl overflow-hidden">
<div class="flex items-center justify-between px-4 py-3 bg-[#030e38] border-b border-blue-950">
<div class="flex items-center gap-2">
<span class="text-[11px] text-[#EEEEEE]/80 font-sans font-medium flex items-center gap-1.5">
<span class="material-symbols-outlined text-[14px] text-[#bac3ff]">terminal</span>strive-cohorts/arch-core
</span>
</div>
<div class="flex items-center gap-1 bg-[#020b30] px-2.5 py-0.5 rounded border border-blue-900 text-[11px] text-[#bac3ff] font-sans font-semibold">Arch Lab</div>
</div>
<div class="flex border-b border-blue-950 bg-[#031144] text-[11px]">
<span class="px-3.5 py-1.5 bg-[#020b30] text-[#bac3ff] border-r border-blue-950 flex items-center gap-1.5 font-sans font-medium">
<span class="material-symbols-outlined text-[13px]">code</span>architecture.ts
</span>
<span class="px-3.5 py-1.5 text-slate-400 border-r border-blue-950 hover:text-[#EEEEEE] transition-colors flex items-center gap-1.5 font-sans">
<span class="material-symbols-outlined text-[13px]">tune</span>pipeline.yml
</span>
</div>
<div class="p-4 space-y-2 bg-[#020b30] font-mono text-[11px] leading-relaxed">
<div class="text-slate-400">// Enterprise Distributed Service Mesh</div>
<div class="text-[#EEEEEE]"><span class="text-[#DA1212]">interface</span> <span class="text-amber-300">SystemBlueprint</span> &#123;</div>
<div class="pl-4 text-[#EEEEEE]">meshNodes: <span class="text-[#bac3ff]">Cluster</span>[];</div>
<div class="pl-4 text-[#EEEEEE]">telemetry: <span class="text-emerald-400">PrometheusObserver</span>;</div>
<div class="pl-4 text-[#EEEEEE]">slaLatency: <span class="text-[#DA1212]">"&lt;12ms"</span>;</div>
<div class="text-[#EEEEEE]">&#125;</div>
</div>
<div class="mx-3 mb-3 p-3.5 rounded-lg bg-[#041562] border border-blue-900 font-sans space-y-3">
<div class="flex items-center justify-between text-xs">
<span class="font-semibold text-white flex items-center gap-1.5">
<span class="material-symbols-outlined text-[#DA1212] text-sm">bolt</span>Cohort Sprint 14 • Week 6
</span>
<span class="text-white font-mono text-[11px] bg-[#DA1212] px-2 py-0.5 rounded font-semibold">92% Passing</span>
</div>
<div class="w-full bg-[#020b30] rounded-full h-1.5 overflow-hidden">
<div class="bg-gradient-to-r from-[#DA1212] to-[#bac3ff] h-1.5 rounded-full" style="width: 92%"></div>
</div>
<div class="flex items-center justify-between pt-1 text-[11px] text-[#EEEEEE]/80 border-t border-blue-900">
<div class="flex items-center gap-1.5"><span class="text-white font-medium">64 PRs Reviewed</span></div>
<span class="font-mono text-xs text-[#bac3ff]">Zero Downtime SLA</span>
</div>
</div>
</div>
</div>
<div class="relative z-20 -mt-8 mx-2 sm:mx-4 p-3.5 sm:p-4 rounded-2xl bg-white border border-[#041562]/15 shadow-2xl flex flex-col gap-3">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2"><span class="text-xs font-bold text-[#041562] tracking-wide">Live Architectural Mentorship • 1-on-1 Code Review</span></div>
<span class="material-symbols-outlined text-[#DA1212] text-lg">videocam</span>
</div>
<style id="sc-live-styles">
  .sc-live-box {
    position: relative;
  }
  .sc-live-box img {
    display: none !important;
  }
  .sc-live-inner {
    position: absolute;
    inset: 0;
    padding: 10px 12px 42px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    pointer-events: none;
    background: radial-gradient(circle at 50% 20%, rgba(4, 21, 98, 0.45) 0%, rgba(2, 11, 48, 0.95) 100%);
    user-select: none;
  }
  .sc-live-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .sc-live-topbar-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sc-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 7px;
    border-radius: 9999px;
    background: rgba(218, 18, 18, 0.15);
    border: 1px solid rgba(218, 18, 18, 0.35);
  }
  .sc-live-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #DA1212;
    box-shadow: 0 0 6px rgba(218, 18, 18, 0.8);
  }
  .sc-live-badge-text {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #DA1212;
    line-height: 1;
  }
  .sc-live-timer {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    font-weight: 600;
    color: #bac3ff;
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .sc-live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 7px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 9px;
    color: rgba(238, 238, 238, 0.65);
    font-weight: 500;
  }
  .sc-live-status-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #10b981;
  }
  .sc-live-stage {
    display: flex;
    gap: 8px;
    align-items: stretch;
    flex: 1;
    max-height: 125px;
    margin: 6px 0;
  }
  .sc-live-tile {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }
  .sc-live-tile-mentor {
    flex: 1;
    background: linear-gradient(145deg, rgba(4, 21, 98, 0.7) 0%, rgba(3, 14, 56, 0.85) 100%);
    border: 1px solid rgba(186, 195, 255, 0.15);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08), 0 4px 12px rgba(0, 0, 0, 0.3);
    padding: 8px;
    gap: 6px;
  }
  .sc-live-tile-mentee {
    width: 28%;
    min-width: 68px;
    max-width: 95px;
    background: linear-gradient(145deg, rgba(3, 14, 56, 0.75) 0%, rgba(2, 9, 36, 0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05), 0 4px 12px rgba(0, 0, 0, 0.25);
    padding: 6px;
    gap: 5px;
  }
  .sc-live-avatar-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sc-live-avatar {
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    user-select: none;
    position: relative;
    z-index: 2;
  }
  .sc-live-avatar-mentor {
    width: 34px;
    height: 34px;
    background: linear-gradient(135deg, #041562 0%, #0d2894 100%);
    border: 1.5px solid rgba(186, 195, 255, 0.45);
    color: #ffffff;
    font-size: 12px;
    letter-spacing: 0.04em;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }
  .sc-live-glow-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid rgba(218, 18, 18, 0.5);
    pointer-events: none;
    transform: translate(-50%, -50%);
    z-index: 1;
  }
  .sc-live-avatar-mentee {
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, #020b30 0%, #112a73 100%);
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    color: #bac3ff;
    font-size: 10px;
    letter-spacing: 0.04em;
  }
  .sc-live-wave {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5px;
    height: 14px;
  }
  .sc-live-bar {
    width: 2.5px;
    height: 14px;
    border-radius: 2px;
    background: linear-gradient(to top, rgba(4, 21, 98, 0.6), #DA1212);
    transform-origin: center bottom;
    transform: scaleY(0.35);
  }
  .sc-live-tile-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 9px;
    color: rgba(186, 195, 255, 0.75);
    letter-spacing: 0.03em;
    line-height: 1;
  }
  .sc-live-bottombar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
  }
  .sc-live-code-strip {
    display: flex;
    flex-direction: column;
    gap: 1.5px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 9px;
    line-height: 1.25;
    opacity: 0.65;
  }
  .sc-live-code-comment {
    color: #8892b0;
  }
  .sc-live-code-check {
    color: #10b981;
    font-weight: 700;
  }
  .sc-live-code-res {
    color: #bac3ff;
  }
  .sc-live-controls {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .sc-live-ctrl-btn {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.7);
  }
  .sc-live-ctrl-btn-end {
    background: rgba(218, 18, 18, 0.85);
    border-color: #DA1212;
    color: #ffffff;
  }
  @media (max-width: 640px) {
    .sc-live-inner {
      padding: 8px 10px 40px 10px;
    }
    .sc-live-avatar-mentor {
      width: 30px;
      height: 30px;
      font-size: 11px;
    }
    .sc-live-glow-ring {
      width: 38px;
      height: 38px;
    }
    .sc-live-avatar-mentee {
      width: 24px;
      height: 24px;
      font-size: 9px;
    }
    .sc-live-stage {
      max-height: 100px;
      margin: 4px 0;
    }
    .sc-live-bar {
      width: 2px;
      height: 12px;
    }
    .sc-live-code-strip {
      font-size: 8px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .sc-live-tile-mentor {
      animation: sc-live-fade-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
    }
    .sc-live-tile-mentee {
      animation: sc-live-fade-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
    }
    .sc-live-bottombar {
      animation: sc-live-fade-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
    }
    @keyframes sc-live-fade-in {
      0% {
        opacity: 0;
        transform: translateY(6px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .sc-live-pulse-dot {
      animation: sc-live-pulse 2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }
    @keyframes sc-live-pulse {
      0%, 100% {
        transform: scale(1);
        opacity: 0.95;
      }
      50% {
        transform: scale(1.4);
        opacity: 0.45;
      }
    }
    .sc-live-glow-ring {
      animation: sc-live-glow-breathe 4.5s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }
    @keyframes sc-live-glow-breathe {
      0%, 100% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.45;
        box-shadow: 0 0 6px rgba(218, 18, 18, 0.25);
      }
      50% {
        transform: translate(-50%, -50%) scale(1.12);
        opacity: 0.9;
        box-shadow: 0 0 14px rgba(218, 18, 18, 0.55);
      }
    }
    .sc-live-bar-1 { animation: sc-live-audio-1 1.4s cubic-bezier(0.22, 1, 0.36, 1) infinite alternate 0s; }
    .sc-live-bar-2 { animation: sc-live-audio-2 1.2s cubic-bezier(0.22, 1, 0.36, 1) infinite alternate 0.3s; }
    .sc-live-bar-3 { animation: sc-live-audio-3 1.7s cubic-bezier(0.22, 1, 0.36, 1) infinite alternate 0.15s; }
    .sc-live-bar-4 { animation: sc-live-audio-4 1.3s cubic-bezier(0.22, 1, 0.36, 1) infinite alternate 0.45s; }
