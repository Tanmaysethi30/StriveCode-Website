  <script is:inline>
    (function () {
      function initDeck() {
        const deck = document.getElementById("scDeck");
        const grid = document.getElementById("scDeckGrid");
        const wrapper = document.getElementById("scDeckWrapper");
        if (!deck || !grid || !wrapper) return;

        // prefers-reduced-motion fallback: retain plain fanned-out grid
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          return;
        }

        const cards = Array.from(grid.querySelectorAll(".sc-deck-card"));
        if (cards.length !== 4) return;

        // Card default stack properties:
        // Card 1: -4deg, dy: 0px, z: 1
        // Card 2: 3deg, dy: 6px, z: 2
        // Card 3: -2deg, dy: 12px, z: 3
        // Card 4: 0deg, dy: 0px, z: 4 (on top)
        const cardProps = [
          { rot: "-4deg", dy: "0px", z: "1" },
          { rot: "3deg", dy: "6px", z: "2" },
          { rot: "-2deg", dy: "12px", z: "3" },
          { rot: "0deg", dy: "0px", z: "4" }
        ];

        cards.forEach((card, i) => {
          const p = cardProps[i];
          card.style.setProperty("--rot", p.rot);
          card.style.setProperty("--dy", p.dy);
          card.style.setProperty("--z", p.z);
        });

        function measure() {
          const deckW = grid.offsetWidth;
          const deckH = grid.offsetHeight;
          const cx = deckW / 2;
          const cy = deckH / 2;
          cards.forEach((card) => {
            const cardX = card.offsetLeft + card.offsetWidth / 2;
            const cardY = card.offsetTop + card.offsetHeight / 2;
            card.style.setProperty("--sx", (cx - cardX) + "px");
            card.style.setProperty("--sy", (cy - cardY) + "px");
          });
        }

        measure();
        deck.classList.add("sc-deck-ready");

        // Recalculate on window load and image completion
        window.addEventListener("load", measure, { once: true });
        cards.forEach((card) => {
          const img = card.querySelector("img");
          if (img && !img.complete) {
            img.addEventListener("load", measure, { once: true });
          }
        });

        // Debounced resize handler
        let resizeRaf = null;
        window.addEventListener("resize", () => {
          if (resizeRaf) cancelAnimationFrame(resizeRaf);
          resizeRaf = requestAnimationFrame(() => {
            measure();
          });
        }, { passive: true });

        // Animation lifecycle & will-change management
        let animTimer = null;
        function setAnimating() {
          deck.classList.add("sc-deck-animating");
          clearTimeout(animTimer);
          animTimer = setTimeout(() => {
            deck.classList.remove("sc-deck-animating");
          }, 850);
        }

        let collapseTimer = null;
        let isFanned = false;

        function openDeck() {
          clearTimeout(collapseTimer);
          if (!isFanned) {
            isFanned = true;
            setAnimating();
            deck.classList.add("sc-deck-fanned");
          }
        }

        function closeDeck(immediate) {
          clearTimeout(collapseTimer);
          if (immediate) {
            if (isFanned) {
              isFanned = false;
              setAnimating();
              deck.classList.remove("sc-deck-fanned");
            }
            return;
          }
          collapseTimer = setTimeout(() => {
            if (isFanned) {
              isFanned = false;
              setAnimating();
              deck.classList.remove("sc-deck-fanned");
            }
          }, 180);
        }

        const isFinePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        if (isFinePointer) {
          // Hovering any card of the deck fans them out
          grid.addEventListener("pointerover", (e) => {
            if (e.target.closest(".sc-deck-card")) {
              openDeck();
            }
          });

          // While pointer stays inside the card area / wrapper, remain open
          wrapper.addEventListener("pointerenter", () => {
            if (isFanned) {
              clearTimeout(collapseTimer);
            }
          });

          // When pointer leaves wrapper, smoothly collapse after 180ms debounce
          wrapper.addEventListener("pointerleave", () => {
            closeDeck();
          });
        }

        // Touch & mobile: auto fan out once when about 35% enters view
        const isTouch = window.matchMedia("(hover: none), (pointer: coarse)").matches;
        if (isTouch || !isFinePointer) {
          const sectionEl = document.getElementById("programs") || wrapper;
          const thresholds = [];
          for (let i = 0; i <= 1.0; i += 0.05) thresholds.push(Number(i.toFixed(2)));
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              const visibleH = entry.intersectionRect.height;
              const targetH = entry.boundingClientRect.height;
              const winH = window.innerHeight;
              const thresholdH = Math.min(winH, targetH) * 0.35;
              if (entry.isIntersecting && (entry.intersectionRatio >= 0.35 || visibleH >= thresholdH)) {
                openDeck();
                observer.disconnect();
              }
            });
          }, { threshold: thresholds });
          observer.observe(sectionEl);
        }

        // Keyboard focus accessibility
        deck.addEventListener("focusin", () => {
          openDeck();
        });
        deck.addEventListener("focusout", (e) => {
          if (!deck.contains(e.relatedTarget)) {
            closeDeck(true);
          }
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initDeck);
      } else {
        initDeck();
      }
    })();
  </script>
</section>
