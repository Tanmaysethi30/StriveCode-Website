---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="StriveCode - Enterprise Engineering Services (Navy &amp; Crimson Theme)"
  description="StriveCode Technology - Enterprise Tech, Training & Career Acceleration"
  currentRoute="/services"
  hasGridMatrix={true}
  isHome={false}
>
  <Fragment slot="head">
    <style is:inline>
.material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-block;
      vertical-align: middle;
      line-height: 1;
    }
    .grid-pattern {
      background-size: 32px 32px;
      background-image: 
        linear-gradient(to right, rgba(4, 21, 98, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(4, 21, 98, 0.05) 1px, transparent 1px);
    }
    .dark-grid-pattern {
      background-size: 24px 24px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    }

    @keyframes marquee-forward {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }
    @keyframes marquee-reverse {
      0% { transform: translateX(-50%); }
      100% { transform: translateX(0%); }
    }
    .animate-marquee-forward {
      display: flex;
      width: max-content;
      animation: marquee-forward 36s linear infinite;
    }
    .animate-marquee-reverse {
      display: flex;
      width: max-content;
      animation: marquee-reverse 36s linear infinite;
    }
    .marquee-container:hover .animate-marquee-forward,
    .marquee-container:hover .animate-marquee-reverse {
      animation-play-state: paused;
    }

    /* Hero section responsive viewport height & vertical alignment */
    .services-hero {
      min-height: auto;
    }
    @media (min-width: 768px) and (max-width: 1023px) {
      .services-hero {
        min-height: 75vh;
        min-height: 75svh;
      }
    }
    @media (min-width: 1024px) {
      .services-hero {
        min-height: calc(100vh - 70px);
        min-height: calc(100svh - 70px);
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
    }
    </style>
  </Fragment>

  <!-- Hero Section -->
<section class="services-hero relative bg-[#EEEEEE] grid-pattern border-b border-slate-300/70 pt-12 sm:pt-14 pb-8 sm:pb-10 md:pt-14 md:pb-10 md:min-h-[75vh] md:min-h-[75svh] lg:pt-0 lg:pb-0 lg:min-h-[calc(100vh-70px)] lg:min-h-[calc(100svh-70px)] lg:flex lg:flex-col lg:justify-center overflow-hidden">
