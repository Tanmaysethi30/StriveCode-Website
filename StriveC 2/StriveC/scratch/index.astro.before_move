<script id="sc-live-timer-script">
(function() {
  'use strict';
  const timerEl = document.getElementById('scLiveTimer');
  if (!timerEl) return;

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reducedMotion) {
    timerEl.textContent = '12:34';
    return;
  }

  let totalSeconds = 0;
  let timerId = null;

  function updateDisplay() {
    const mins = Math.floor(totalSeconds / 60);
    const secs = totalSeconds % 60;
    timerEl.textContent =
      (mins < 10 ? '0' + mins : mins) + ':' + (secs < 10 ? '0' + secs : secs);
  }

  function startTimer() {
    if (timerId !== null) return;
    timerId = setInterval(function() {
      totalSeconds++;
      updateDisplay();
    }, 1000);
  }

  function stopTimer() {
    if (timerId !== null) {
      clearInterval(timerId);
      timerId = null;
    }
  }

  startTimer();

  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      stopTimer();
    } else {
      startTimer();
    }
  });
})();
</script>
