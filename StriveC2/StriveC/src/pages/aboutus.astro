<p class="text-slate-600 text-xs font-medium mt-0.5">Business Consultant</p>
</div>
<span class="bg-[#041562] text-[#FFFFFF] text-xs font-semibold px-3 py-1 rounded-full w-fit mt-3 opacity-90 transition-all duration-300 group-hover:bg-[#DA1212]">
        Strategy &amp; Consulting
      </span>
</div>
<!-- Member 02: Vansh Jain -->
<div class="team-card bg-[#FFFFFF] rounded-2xl p-5 border border-primary/10 shadow-[0_4px_16px_-2px_rgba(4,21,98,0.06)] flex flex-col justify-between group cursor-default is-revealed">
<div>
<div class="rounded-[18px] overflow-hidden bg-slate-100 aspect-[4/5] w-full mb-4">
<img alt="Vansh Jain, Head of Digital Media & Finance" class="portrait-img w-full h-full object-cover" style="object-position: center top;" width="433" height="577" loading="lazy" decoding="async" src="/assets/members/vansh-jain.png">
</div>
<h4 class="text-[#041562] font-title-lg text-lg font-bold">Vansh Jain</h4>
<p class="text-slate-600 text-xs font-medium mt-0.5">Head of Digital Media &amp; Finance</p>
</div>
<span class="bg-[#041562] text-[#FFFFFF] text-xs font-semibold px-3 py-1 rounded-full w-fit mt-3 opacity-90 transition-all duration-300 group-hover:bg-[#DA1212]">
        Finance &amp; Media
      </span>
</div>
<!-- Member 03: Shyamu -->
<div class="team-card bg-[#FFFFFF] rounded-2xl p-5 border border-primary/10 shadow-[0_4px_16px_-2px_rgba(4,21,98,0.06)] flex flex-col justify-between group cursor-default is-revealed">
