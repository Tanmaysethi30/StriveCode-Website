---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="StriveCode Technology | Enterprise Engineering Cohorts"
  description="StriveCode Technology - Enterprise Tech, Training & Career Acceleration"
  currentRoute="/courses"
  hasGridMatrix={false}
  isHome={false}
>
  <Fragment slot="head">
    <style is:inline>
.material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-block;
      vertical-align: middle;
      line-height: 1;
    }
    .custom-grid-pattern {
      background-size: 40px 40px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    }
    /* Animated Conduit Line in Step 4 */
    @keyframes pulseConnector {
      0% {
        background-position: -200% 0;
      }
      100% {
        background-position: 200% 0;
      }
    }
    .data-stream-line {
      background: linear-gradient(90deg, rgba(255,255,255,0.12) 0%, rgba(218,18,18,0.7) 25%, #DA1212 50%, rgba(218,18,18,0.7) 75%, rgba(255,255,255,0.12) 100%);
      background-size: 200% 100%;
      animation: pulseConnector 3.5s linear infinite;
    }
    .conduit-subtle-line {
      background: linear-gradient(90deg, rgba(4,21,98,0.08) 0%, rgba(218,18,18,0.3) 50%, rgba(4,21,98,0.08) 100%);
    }
    /* Dynamic Transformation Stage Card Enhancements */
    .transformation-card {
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .transformation-card:hover {
      transform: translateY(-8px) scale(1.02);
      border-color: rgba(218, 18, 18, 0.7);
      box-shadow: 0 20px 35px -10px rgba(218, 18, 18, 0.28), 0 0 0 1px rgba(218, 18, 18, 0.35);
    }
    .transformation-card:hover .step-badge {
      color: #DA1212;
      text-shadow: 0 0 12px rgba(218, 18, 18, 0.6);
      transform: translateY(-1px);
    }
    .transformation-card:hover .step-icon-box {
      border-color: #DA1212;
      color: #DA1212;
      box-shadow: 0 0 18px rgba(218, 18, 18, 0.55);
      background-color: rgba(218, 18, 18, 0.12);
      transform: scale(1.08);
    }
    .transformation-card:hover .gate-pill {
      background-color: rgba(218, 18, 18, 0.18);
      border-color: rgba(218, 18, 18, 0.5);
      color: #ffffff;
    }
    /* Apple-inspired Nav Apply Now button */
    .apple-nav-btn {
      background-color: #DA1212;
      color: #FFFFFF;
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .apple-nav-btn:hover {
      transform: translateY(-2px) scale(1.04);
      box-shadow: 0 10px 24px -6px rgba(218, 18, 18, 0.45);
      border: 1.5px solid #FFFFFF;
    }
    .apple-nav-btn .btn-arrow {
      display: inline-block;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .apple-nav-btn:hover .btn-arrow {
      transform: translateX(4px);
    }
    </style>
  </Fragment>

  <!-- SECTION 2: ENTERPRISE HERO & GLASSMORPHIC METRICS BAR -->
<section class="relative bg-primary-container text-surface-container-lowest overflow-hidden py-24 custom-grid-pattern">
<div class="max-w-7xl mx-auto px-6 lg:px-12 text-center relative z-10">
<!-- Pill Badge -->
<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-md mb-6">
<span class="font-label-sm text-label-sm text-surface-container-lowest uppercase tracking-wider">INDUSTRY-ALIGNED ENGINEERING COHORTS</span>
</div>
<!-- Headline -->
<h1 class="font-display text-display font-extrabold text-surface-container-lowest tracking-tight max-w-5xl mx-auto mb-6">
        Master Skills That Enterprise Teams Actually Need
      </h1>
<!-- Subheadline -->
<p class="font-body-lg text-body-lg text-surface-container max-w-3xl mx-auto mb-10 leading-relaxed">
        Rigorous cohort-based engineering programs designed with staff architects from top tech companies. Master distributed systems, production AI, and cloud infrastructure.
      </p>
<!-- Live Cohort Pulse: Overlapping Human Engineer Avatars & Badge -->
<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
<div class="inline-flex items-center gap-3.5 px-5 py-2.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-md shadow-lg transition-transform hover:scale-[1.02]">
