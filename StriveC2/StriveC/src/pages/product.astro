  <Fragment slot="scripts">
    <script is:inline >
document.addEventListener('DOMContentLoaded', () => {
      // 1. Filter tabs logic
      const filterButtons = document.querySelectorAll('.filter-btn');
      const productCards = document.querySelectorAll('.product-card');

      filterButtons.forEach(button => {
        button.addEventListener('click', () => {
          const filterValue = button.getAttribute('data-filter');

          // Update Segmented Button States
          filterButtons.forEach(btn => {
            btn.classList.remove('bg-white', 'text-[#041562]', 'shadow-apple-sm');
            btn.classList.add('text-[#041562]/70');
          });

          button.classList.add('bg-white', 'text-[#041562]', 'shadow-apple-sm');
          button.classList.remove('text-[#041562]/70');

          // Filter Products
          productCards.forEach(card => {
            const category = card.getAttribute('data-category');
            if (filterValue === 'all' || category === filterValue) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // 2. Apple-Style Scroll-Linked 3D Scatter & Fly-Out Parallax Animation
      const leftDevice = document.getElementById('hero-device-left');
      const centerDevice = document.getElementById('hero-device-center');
      const rightDevice = document.getElementById('hero-device-right');

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion && leftDevice && centerDevice && rightDevice) {
        let isTicking = false;

        const handleScroll = () => {
          const scrollY = window.scrollY || window.pageYOffset || 0;
          const maxScroll = 420; // Complete scatter progress reached around 400-420px
          const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);

          // Left Device: Fly My Journey
          const leftTx = -220 * progress;
          const leftTy = -120 * progress;
          const leftTz = 80 * progress;
          const leftRotZ = -6 - (16 * progress);
          const leftRotY = 18 * progress;
          const leftOpacity = 1 - (0.78 * progress);
          const leftGlow = progress > 0.05 ? `0 24px 48px -10px rgba(218, 18, 18, ${0.15 + 0.18 * progress}), 0 10px 24px -6px rgba(4, 21, 98, 0.08)` : '';

          leftDevice.style.transform = `translate3d(${leftTx}px, ${leftTy}px, ${leftTz}px) rotateZ(${leftRotZ}deg) rotateY(${leftRotY}deg)`;
          leftDevice.style.opacity = leftOpacity;
          if (leftGlow) leftDevice.style.boxShadow = leftGlow;
          else leftDevice.style.boxShadow = '';

          // Center Device: StriveCode ERP/CRM Platform
          const centerTy = -90 * progress;
          const centerTz = 140 * progress;
          const centerRotX = 16 * progress;
          const centerScale = 1 + (0.08 * progress);
          const centerShadowY = 35 + (35 * progress);
          const centerShadowBlur = 70 + (40 * progress);
          const centerShadowOpacity = 0.12 + (0.10 * progress);

          centerDevice.style.transform = `translate3d(0px, ${centerTy}px, ${centerTz}px) rotateX(${centerRotX}deg) scale(${centerScale})`;
          centerDevice.style.boxShadow = `0 ${centerShadowY}px ${centerShadowBlur}px -15px rgba(4, 21, 98, ${centerShadowOpacity}), 0 15px 30px -10px rgba(0, 0, 0, 0.06)`;

          // Right Device: Health Tracker
          const rightTx = 220 * progress;
          const rightTy = -120 * progress;
          const rightTz = 80 * progress;
          const rightRotZ = 6 + (16 * progress);
          const rightRotY = -18 * progress;
          const rightOpacity = 1 - (0.78 * progress);
          const rightGlow = progress > 0.05 ? `0 24px 48px -10px rgba(218, 18, 18, ${0.15 + 0.18 * progress}), 0 10px 24px -6px rgba(4, 21, 98, 0.08)` : '';

          rightDevice.style.transform = `translate3d(${rightTx}px, ${rightTy}px, ${rightTz}px) rotateZ(${rightRotZ}deg) rotateY(${rightRotY}deg)`;
          rightDevice.style.opacity = rightOpacity;
          if (rightGlow) rightDevice.style.boxShadow = rightGlow;
          else rightDevice.style.boxShadow = '';

          isTicking = false;
        };

        window.addEventListener('scroll', () => {
          if (!isTicking) {
            window.requestAnimationFrame(handleScroll);
            isTicking = true;
          }
        }, { passive: true });

        // Trigger once on page load to preserve resting coordinates
        handleScroll();
      }
    });
    </script>
