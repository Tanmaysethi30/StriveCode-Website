<div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center mb-6 text-primary-container group-hover:bg-[#041562] group-hover:text-white transition-colors">
<span class="material-symbols-outlined text-headline-sm" data-icon="hub">hub</span>
</div>
