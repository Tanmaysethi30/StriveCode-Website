    <script is:inline id="sc-reveal-script">
(function() {
  // 1. Ensure scroll position starts at the top on every open, reload and bfcache restore
  if ('scrollRestoration' in history) {
    history.scrollRestoration = 'manual';
  }

  function ensureTopPosition() {
    if (!window.location.hash) {
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo(0, 0);
      requestAnimationFrame(function() {
        setTimeout(function() {
          document.documentElement.style.scrollBehavior = '';
        }, 120);
      });
    }
  }

  ensureTopPosition();
  window.addEventListener('load', ensureTopPosition);
  window.addEventListener('pageshow', function(event) {
    ensureTopPosition();
  });

  // Clicking "About us" links while on this page scrolls back to top
  document.querySelectorAll('a[href="Aboutus.html"], a[href="./Aboutus.html"]').forEach(function(link) {
    link.addEventListener('click', function() {
      if (!window.location.hash) {
        document.documentElement.style.scrollBehavior = 'smooth';
        window.scrollTo(0, 0);
      }
    });
  });

  // 2. Leadership & Core Specialists Scroll-Triggered Reveal
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reducedMotion || !('IntersectionObserver' in window)) {
    return;
  }

  function initTeamReveal() {
    const leaderCard = document.querySelector('section .dark-blueprint-grid');
    const gridCards = Array.from(document.querySelectorAll('.team-gallery .team-card'));
    if (!leaderCard && !gridCards.length) return;

    const allCards = leaderCard ? [leaderCard, ...gridCards] : gridCards;

    // Apply initial hidden state through JS
    if (leaderCard) {
      leaderCard.classList.add('sc-reveal-card');
      leaderCard.style.setProperty('--sc-duration', '1.1s');
      leaderCard.style.setProperty('--sc-delay', '0s');
    }

    gridCards.forEach((card) => {
      card.classList.add('sc-reveal-card');
      card.style.setProperty('--sc-duration', '0.9s');
      card.style.setProperty('--sc-delay', '0s');
    });

    // Calculate row staggers using responsive column math (zero layout reflow)
    function calculateRowStaggers() {
      let cols = 4;
      const w = window.innerWidth;
      if (w < 640) cols = 1;
      else if (w < 768) cols = 2;
      else if (w < 1024) cols = 3;

      gridCards.forEach((card, idx) => {
        if (card.classList.contains('sc-reveal-visible')) return;
        const colIndex = idx % cols;
        card.style.setProperty('--sc-delay', (colIndex * 130) + 'ms');
      });
    }

    calculateRowStaggers();
    window.addEventListener('resize', calculateRowStaggers, { passive: true });

    // IntersectionObserver with threshold 0.15 and rootMargin '0px 0px -8% 0px'
    const observer = new IntersectionObserver((entries, obs) => {
      const intersectingEntries = entries.filter(e => e.isIntersecting);
      if (!intersectingEntries.length) return;

      intersectingEntries.sort((a, b) => allCards.indexOf(a.target) - allCards.indexOf(b.target));

      const isMultiBatch = intersectingEntries.length > 4;

      intersectingEntries.forEach((entry, idx) => {
        const card = entry.target;
        obs.unobserve(card);

        if (isMultiBatch) {
          card.style.setProperty('--sc-delay', (idx * 110) + 'ms');
        }

        card.classList.add('sc-reveal-animating');
        requestAnimationFrame(() => {
          card.classList.add('sc-reveal-visible');
        });

        const durationMs = card === leaderCard ? 1100 : 900;
        const delayStr = card.style.getPropertyValue('--sc-delay') || '0ms';
        const delayMs = parseInt(delayStr, 10) || 0;

        setTimeout(() => {
          card.classList.remove('sc-reveal-animating');
          card.style.willChange = 'auto';
        }, durationMs + delayMs + 120);
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -8% 0px'
    });

    allCards.forEach((card) => {
      observer.observe(card);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTeamReveal);
  } else {
    initTeamReveal();
  }
})();
    </script>
